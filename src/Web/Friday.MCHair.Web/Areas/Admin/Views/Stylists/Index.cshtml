@model IReadOnlyList<Friday.Modules.Salon.Domain.Entities.Stylist>
@{
    ViewData["Title"] = "Thợ";
}

<a class="btn btn-primary" asp-action="Edit">Thêm thợ</a>
<table class="admin-table">
    <thead><tr><th>Tên</th><th>Chức danh</th><th>Hiển thị</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Title</td>
                <td>@(item.IsActive ? "Có" : "Ẩn")</td>
                <td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a></td>
            </tr>
        }
    </tbody>
</table>

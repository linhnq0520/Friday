@model string?
@{
    var fieldName = ViewData["ImageFieldName"] as string ?? "ImageUrl";
    var label = ViewData["ImageLabel"] as string ?? "Ảnh";
}

<div class="form-group image-upload-field">
    <label>@label</label>
    @if (!string.IsNullOrWhiteSpace(Model))
    {
        <img src="@Model" alt="Preview" class="image-preview" />
    }
    <label class="file-label">Chọn ảnh từ máy</label>
    <input type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif" />
    <p class="hint">Hoặc dán link ảnh (URL):</p>
    <input name="@fieldName" value="@Model" placeholder="https://..." />
</div>

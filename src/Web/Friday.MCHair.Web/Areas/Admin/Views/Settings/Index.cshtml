@model IReadOnlyDictionary<string, string>
@{
    ViewData["Title"] = "Cài đặt & SEO";
    string V(string key) => Model.GetValueOrDefault(key, "");
}

<form method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <div class="form-group"><label>Tên salon</label><input name="site_name" value="@V("site_name")" /></div>
    <div class="form-group"><label>Tagline</label><input name="tagline" value="@V("tagline")" /></div>
    <div class="form-group"><label>Hotline</label><input name="hotline" value="@V("hotline")" /></div>
    <div class="form-group"><label>Email</label><input name="email" value="@V("email")" /></div>
    <div class="form-group"><label>Địa chỉ</label><input name="address" value="@V("address")" /></div>
    <div class="form-group"><label>Giờ mở cửa</label><input name="opening_hours" value="@V("opening_hours")" /></div>
    <div class="form-group"><label>Facebook</label><input name="facebook" value="@V("facebook")" /></div>
    <div class="form-group"><label>Zalo</label><input name="zalo" value="@V("zalo")" /></div>
    <div class="form-group"><label>Instagram</label><input name="instagram" value="@V("instagram")" /></div>
    <div class="form-group"><label>SEO Title</label><input name="seo_title" value="@V("seo_title")" /></div>
    <div class="form-group"><label>SEO Description</label><textarea name="seo_description" rows="3">@V("seo_description")</textarea></div>
    <button type="submit" class="btn btn-primary">Lưu</button>
</form>

@model IReadOnlyDictionary<string, string>
@using Friday.MCHair.Web.Models
@{
    ViewData["Title"] = "Cài đặt & SEO";
    string V(string key) => Model.GetValueOrDefault(key, "");
    string bookingMode = V(BookingSettings.ModeKey);
    if (string.IsNullOrWhiteSpace(bookingMode))
    {
        bookingMode = SiteContent.DefaultBookingMode;
    }
}

<form method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <div class="form-group"><label>Tên salon</label><input name="site_name" value="@V("site_name")" /></div>
    <div class="form-group"><label>Tagline</label><input name="tagline" value="@V("tagline")" /></div>
    <div class="form-group"><label>Hotline</label><input name="hotline" value="@V("hotline")" /></div>
    <div class="form-group"><label>Email</label><input name="email" value="@V("email")" /></div>
    <div class="form-group"><label>Địa chỉ đầy đủ</label><input name="address" value="@V("address")" /></div>
    <div class="form-group"><label>Địa chỉ ngắn (thanh trên)</label><input name="address_short" value="@V("address_short")" /></div>
    <div class="form-group"><label>Link Google Maps</label><input name="maps_url" value="@V("maps_url")" /></div>
    <div class="form-group"><label>Giờ mở cửa</label><input name="opening_hours" value="@V("opening_hours")" /></div>
    <div class="form-group"><label>Facebook (fanpage)</label><input name="facebook" value="@V("facebook")" /></div>
    <div class="form-group"><label>Zalo (SĐT hoặc link)</label><input name="zalo" value="@V("zalo")" placeholder="0988305371 hoặc https://zalo.me/..." /></div>
    <div class="form-group"><label>Messenger (link m.me)</label><input name="messenger_url" value="@V("messenger_url")" placeholder="https://m.me/..." /></div>
    <div class="form-group"><label>Instagram</label><input name="instagram" value="@V("instagram")" /></div>
    <h2>Đặt lịch</h2>
    <div class="form-group">
        <label>Chế độ đặt lịch</label>
        <select name="@BookingSettings.ModeKey">
            @if (bookingMode == BookingSettings.ModeEasySalon)
            {
                <option value="@BookingSettings.ModeEasySalon" selected>EasySalon (mở trang đặt lịch ngoài)</option>
                <option value="@BookingSettings.ModeInternal">Form đặt lịch trên website</option>
            }
            else
            {
                <option value="@BookingSettings.ModeEasySalon">EasySalon (mở trang đặt lịch ngoài)</option>
                <option value="@BookingSettings.ModeInternal" selected>Form đặt lịch trên website</option>
            }
        </select>
        <p class="form-hint">EasySalon mở tab mới; form nội bộ dùng trang /Booking và quản lý lịch trong Admin.</p>
    </div>
    <div class="form-group">
        <label>Link EasySalon</label>
        <input name="@BookingSettings.ExternalUrlKey" value="@V(BookingSettings.ExternalUrlKey)" placeholder="@SiteContent.DefaultBookingEasySalonUrl" />
    </div>
    <div class="form-group"><label>SEO Title</label><input name="seo_title" value="@V("seo_title")" /></div>
    <div class="form-group"><label>SEO Description</label><textarea name="seo_description" rows="3">@V("seo_description")</textarea></div>
    <button type="submit" class="btn btn-primary">Lưu</button>
</form>

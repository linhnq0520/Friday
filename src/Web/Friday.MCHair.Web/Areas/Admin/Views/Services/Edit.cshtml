        // =========================================================================
        // AUTO-SAVE DRAFT & RECOVERY VIA LOCALSTORAGE
        // =========================================================================
        function setupAutoSave() {
            const form = document.getElementById('serviceForm');
            form.addEventListener('input', debounce(saveDraft, 1000));
            form.addEventListener('change', debounce(saveDraft, 1000));

            // Clear draft when submitting successfully
            form.addEventListener('submit', function() {
                localStorage.removeItem(draftStorageKey);
            });
        }

        function saveDraft() {
            const draft = {
                timestamp: Date.now(),
                name: document.getElementById('serviceNameInput').value,
                slug: document.getElementById('serviceSlugInput').value,
                headline: document.getElementById('serviceHeadlineInput').value,
                shortDesc: document.getElementById('serviceShortDescInput').value,
                desc: document.getElementById('serviceDescInput').value,
                priceTag: document.getElementById('servicePriceTagInput').value,
                priceFrom: document.getElementById('servicePriceFromInput').value,
                duration: document.getElementById('serviceDurationInput').value,
                badge: document.getElementById('serviceBadgeInput').value,
                sortOrder: document.getElementById('serviceSortOrderInput').value,
                isActive: document.getElementById('serviceIsActiveInput').checked,
                priceConfig,
                priceItems,
                priceAddons,
                methodsList,
                stepsList,
                faqsList
            };
            try {
                localStorage.setItem(draftStorageKey, JSON.stringify(draft));
            } catch(e) {
                console.warn('Quota exceeded or error saving draft', e);
            }
        }

        function checkAndPromptDraft() {
            try {
                const stored = localStorage.getItem(draftStorageKey);
                if (!stored) return false;
                const draft = JSON.parse(stored);
                // If draft is within last 48 hours
                if (draft && draft.timestamp && (Date.now() - draft.timestamp) < 48 * 3600 * 1000) {
                    if (draft.name || draft.slug || (draft.priceItems && draft.priceItems.length > 0)) {
                        // Restore draft data
                        if (draft.name !== undefined) document.getElementById('serviceNameInput').value = draft.name;
                        if (draft.slug !== undefined) document.getElementById('serviceSlugInput').value = draft.slug;
                        if (draft.headline !== undefined) document.getElementById('serviceHeadlineInput').value = draft.headline;
                        if (draft.shortDesc !== undefined) document.getElementById('serviceShortDescInput').value = draft.shortDesc;
                        if (draft.desc !== undefined) document.getElementById('serviceDescInput').value = draft.desc;
                        if (draft.priceTag !== undefined) document.getElementById('servicePriceTagInput').value = draft.priceTag;
                        if (draft.priceFrom !== undefined) document.getElementById('servicePriceFromInput').value = draft.priceFrom;
                        if (draft.duration !== undefined) document.getElementById('serviceDurationInput').value = draft.duration;
                        if (draft.badge !== undefined) document.getElementById('serviceBadgeInput').value = draft.badge;
                        if (draft.sortOrder !== undefined) document.getElementById('serviceSortOrderInput').value = draft.sortOrder;
                        if (draft.isActive !== undefined) document.getElementById('serviceIsActiveInput').checked = draft.isActive;

                        if (draft.priceConfig) priceConfig = draft.priceConfig;
                        if (draft.priceItems) priceItems = draft.priceItems;
                        if (draft.priceAddons) priceAddons = draft.priceAddons;
                        if (draft.methodsList) methodsList = draft.methodsList;
                        if (draft.stepsList) stepsList = draft.stepsList;
                        if (draft.faqsList) faqsList = draft.faqsList;

                        document.getElementById('draftAlert').style.display = 'flex';
                        return true;
                    }
                }
            } catch(e) {
                console.warn('Error reading draft', e);
            }
            return false;
        }

        async function discardDraft() {
            const confirmed = await customConfirm('Bạn có chắc muốn xóa bản nháp và quay về dữ liệu gốc không?', {
                title: 'Xác nhận xóa bản nháp',
                okText: '🗑 Xóa bản nháp',
                okClass: 'btn-modal-danger'
            });
            if (confirmed) {
                localStorage.removeItem(draftStorageKey);
                window.location.reload();
            }
        }

        function debounce(func, wait) {
            let timeout;
            return function(...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }

        function escapeHtml(text) {
            if (!text) return '';
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.toString().replace(/[&<>"']/g, m => map[m]);
        }

        // =========================================================================
        // SLUG GENERATION
        // =========================================================================
        function generateSlug(text) {
            if (!text) return '';
            let slug = text.toLowerCase().trim();
            const vietnamese = ["áàảãạăắằẳẵặâấầẩẫậ", "đ", "éèẻẽẹêếềểễệ", "íìỉĩị", "óòỏõọôốồổỗộơớờởỡợ", "úùủũụưứừửữự", "ýỳỷỹỵ"];
            const ascii = ["a", "d", "e", "i", "o", "u", "y"];
            for (let i = 0; i < vietnamese.Length; i++) {
                for (let c of vietnamese[i]) {
                    slug = slug.replaceAll(c, ascii[i]);
                }
            }
            slug = slug.replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
            return slug;
        }

        function autoGenerateSlug() {
            const name = document.getElementById('serviceNameInput').value;
            const slugInput = document.getElementById('serviceSlugInput');
            if (name) {
                slugInput.value = generateSlug(name);
                saveDraft();
            }
        }

        document.getElementById('serviceNameInput').addEventListener('input', function() {
            const slugInput = document.getElementById('serviceSlugInput');
            if (!slugInput.dataset.manualEdited) {
                slugInput.value = generateSlug(this.value);
            }
        });

        document.getElementById('serviceSlugInput').addEventListener('input', function() {
            this.dataset.manualEdited = "true";
        });


@model IReadOnlyList<Friday.Modules.Salon.Domain.Entities.GalleryItem>
@using Friday.MCHair.Web.Models
@using Friday.Modules.Salon.Application.Models
@using Friday.Modules.Salon.Domain.Enums
@{
    ViewData["Title"] = "Bộ sưu tập";
    var category = ViewBag.Category as GalleryCategory?;
}

<div class="admin-gallery-tabs">
    <a asp-action="Index" class="@(category is null ? "active" : "")">Tất cả</a>
    @foreach (var cat in GalleryCategoryInfo.CollectionCategories)
    {
        <a asp-action="Index" asp-route-category="@((int)cat)" class="@(category == cat ? "active" : "")">@GalleryCategoryLabels.GetLabel(cat)</a>
    }
</div>

<div class="admin-gallery-upload">
    <h2>Thêm ảnh</h2>
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="admin-form">
        @Html.AntiForgeryToken()
        <div class="form-row">
            <label>
                Bộ sưu tập
                <select name="category" required>
                    @foreach (var cat in GalleryCategoryInfo.CollectionCategories)
                    {
                        if (category == cat)
                        {
                            <option value="@((int)cat)" selected>@GalleryCategoryLabels.GetLabel(cat)</option>
                        }
                        else
                        {
                            <option value="@((int)cat)">@GalleryCategoryLabels.GetLabel(cat)</option>
                        }
                    }
                </select>
            </label>
            <label>
                Tiêu đề (tuỳ chọn)
                <input type="text" name="title" maxlength="200" />
            </label>
            <label>
                Ảnh
                <input type="file" name="imageFile" accept="image/*" required />
            </label>
        </div>
        <button type="submit" class="btn btn-primary">Tải lên</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <p class="muted">Chưa có ảnh trong danh mục này.</p>
}
else
{
    <div class="admin-gallery-grid">
        @foreach (var item in Model)
        {
            <article class="admin-gallery-item">
                <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                <div class="admin-gallery-meta">
                    <strong>@GalleryCategoryLabels.GetLabel(item.Category)</strong>
                    <span>@item.Title</span>
                    <form asp-action="Delete" method="post" class="inline-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn-danger" onclick="return confirm('Xóa ảnh này?')">Xóa</button>
                    </form>
                </div>
            </article>
        }
    </div>
}

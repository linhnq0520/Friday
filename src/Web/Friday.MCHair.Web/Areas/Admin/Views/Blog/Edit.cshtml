@using Friday.MCHair.Web.Services
@model Friday.Modules.Salon.Domain.Entities.BlogPost
@{
    ViewData["Title"] = Model.Id == 0 ? "Viết bài mới" : $"Sửa bài viết: {Model.Title}";
}

<div class="blog-edit-wrapper">
    <!-- Top Action & Mode Switcher Bar -->
    <div class="edit-top-header">
        <div class="mode-tabs">
            <button type="button" class="mode-tab is-active" id="tabEditMode">
                <span>✏️ Soạn thảo</span>
            </button>
            <button type="button" class="mode-tab" id="tabPreviewMode">
                <span>👁️ Xem trước bài viết</span>
            </button>
        </div>

        <div class="top-actions">
            @if (Model.Id > 0 && !string.IsNullOrWhiteSpace(Model.Slug))
            {
                <a href="/tin-tuc/@Model.Slug" target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                    ↗ Xem trên Website
                </a>
            }
            <button type="button" class="btn btn-primary" onclick="document.getElementById('blogForm').requestSubmit()">
                💾 Lưu bài viết
            </button>
        </div>
    </div>

    <!-- MAIN FORM -->
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="admin-form-wide" id="blogForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert error"></div>
        <input type="hidden" asp-for="Id" />

        <!-- EDIT VIEW PANEL -->
        <div id="panelEditView" class="view-panel is-active">
            <div class="form-grid-2">
                <!-- Main Content Column (Expands Full Width) -->
                <div class="form-col-main">
                    <div class="admin-card form-box-main">
                        <div class="form-group">
                            <label asp-for="Title" class="form-label-prominent">
                                <strong>Tiêu đề bài viết <span class="required">*</span></strong>
                            </label>
                            <input asp-for="Title" id="blogTitle" required 
                                   placeholder="Ví dụ: Top 5 xu hướng màu nhuộm Balayage & Highlight đẹp nhất 2026" 
                                   class="form-control input-title-lg" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group slug-form-group">
                            <label asp-for="Slug">
                                <strong>Đường dẫn SEO (Slug) <span class="required">*</span></strong>
                                <button type="button" class="btn-text-action" id="btnAutoSlug">🔄 Tự sinh từ tiêu đề</button>
                            </label>
                            <div class="input-prefix-group">
                                <span class="input-prefix">https://mchair.vn/tin-tuc/</span>
                                <input asp-for="Slug" id="blogSlug" required placeholder="top-5-xu-huong-mau-nhuom" class="form-control" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="Summary"><strong>Tóm tắt ngắn (Excerpt / Mô tả hiển thị ở thẻ bài viết)</strong></label>
                            <textarea asp-for="Summary" id="blogSummary" rows="3" 
                                      placeholder="Đoạn văn ngắn 1-2 câu tóm tắt nội dung hấp dẫn để khách hàng đọc lướt..." 
                                      class="form-control"></textarea>
                        </div>

                        <div class="form-group editor-group">
                            <label><strong>Nội dung chi tiết bài viết <span class="required">*</span></strong></label>
                            
                            <!-- WYSIWYG Editor Toolbar -->
                            <div class="editor-toolbar" id="editorToolbar">
                                <div class="toolbar-group">
                                    <button type="button" class="toolbar-btn" data-cmd="formatBlock" data-val="h2" title="Tiêu đề H2"><b>H2</b></button>
                                    <button type="button" class="toolbar-btn" data-cmd="formatBlock" data-val="h3" title="Tiêu đề H3"><b>H3</b></button>
                                    <button type="button" class="toolbar-btn" data-cmd="formatBlock" data-val="p" title="Đoạn văn thường">P</button>
                                </div>
                                <span class="toolbar-divider"></span>
                                <div class="toolbar-group">
                                    <button type="button" class="toolbar-btn" data-cmd="bold" title="In đậm (Ctrl+B)"><b>B</b></button>
                                    <button type="button" class="toolbar-btn" data-cmd="italic" title="In nghiêng (Ctrl+I)"><i>I</i></button>
                                    <button type="button" class="toolbar-btn" data-cmd="underline" title="Gạch chân (Ctrl+U)"><u>U</u></button>
                                </div>
                                <span class="toolbar-divider"></span>
                                <div class="toolbar-group">
                                    <button type="button" class="toolbar-btn" data-cmd="insertUnorderedList" title="Danh sách chấm">• Danh sách</button>
                                    <button type="button" class="toolbar-btn" data-cmd="insertOrderedList" title="Danh sách số">1. Số</button>
                                    <button type="button" class="toolbar-btn" data-cmd="formatBlock" data-val="blockquote" title="Khối trích dẫn">“ Trích dẫn</button>
                                </div>
                                <span class="toolbar-divider"></span>
                                <div class="toolbar-group">
                                    <button type="button" class="toolbar-btn" id="btnInsertLink" title="Chèn liên kết">🔗 Link</button>
                                    <button type="button" class="toolbar-btn toolbar-btn-highlight" id="btnOpenImageModal" title="Chèn ảnh vào vị trí con trỏ chuột">
                                        📷 Chèn hình ảnh...
                                    </button>
                                    <button type="button" class="toolbar-btn toolbar-btn-video" id="btnOpenVideoModal" title="Chèn Video YouTube vào vị trí con trỏ chuột">
                                        🎬 Chèn Video YouTube...
                                    </button>
                                    <button type="button" class="toolbar-btn" id="btnToggleHtml" title="Chuyển chế độ xem mã nguồn HTML">HTML</button>
                                </div>
                            </div>

                            <!-- Visual Editable Container with Drag-and-Drop & Paste -->
                            <div class="editor-wrapper">
                                <div id="visualEditor" class="visual-editor" contenteditable="true" spellcheck="false">
                                    @Html.Raw(Model.Content)
                                </div>

                                <!-- Floating Mini Toolbar for Selected Image -->
                                <div id="imageControlToolbar" class="image-control-toolbar" style="display:none;">
                                    <span class="img-tb-label">Ảnh:</span>
                                    <button type="button" class="img-tb-btn" data-size="100%">100% Rộng</button>
                                    <button type="button" class="img-tb-btn" data-size="75%">75% Vừa</button>
                                    <button type="button" class="img-tb-btn" data-size="50%">50% Nhỏ</button>
                                    <span class="toolbar-divider"></span>
                                    <button type="button" class="img-tb-btn" data-align="left" title="Căn trái">⬅ Trái</button>
                                    <button type="button" class="img-tb-btn" data-align="center" title="Căn giữa">⏺ Giữa</button>
                                    <button type="button" class="img-tb-btn" data-align="right" title="Căn phải">➡ Phải</button>
                                    <span class="toolbar-divider"></span>
                                    <button type="button" class="img-tb-btn btn-danger-tb" id="btnDeleteSelectedImage" title="Xóa ảnh này">🗑 Xóa ảnh</button>
                                </div>
                            </div>

                            <p class="editor-hint">
                                💡 <strong>Mẹo:</strong> Nhấp con trỏ vào vị trí muốn chèn ảnh $\rightarrow$ Bấm nút <strong>"📷 Chèn hình ảnh..."</strong> (hỗ trợ cả chọn file từ máy tính và link ảnh từ Google Drive / Web). Bạn cũng có thể <strong>kéo thả ảnh trực tiếp</strong> vào bài hoặc nhấn <strong>Ctrl + V</strong> để dán ảnh.
                            </p>

                            <!-- Hidden textarea that syncs on submit -->
                            <textarea asp-for="Content" id="blogContentHidden" style="display:none;"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Sidebar Column (Settings & SEO) -->
                <div class="form-col-sidebar">
                    <!-- Publishing Box -->
                    <div class="admin-card sidebar-box">
                        <h3 class="box-title">Đăng bài &amp; Trạng thái</h3>

                        <div class="form-group">
                            <label asp-for="Category"><strong>Chuyên mục</strong></label>
                            <input asp-for="Category" id="blogCategory" list="categoryOptions" class="form-control" placeholder="Chọn hoặc nhập chuyên mục..." />
                            <datalist id="categoryOptions">
                                <option value="Xu hướng tóc" />
                                <option value="Chăm sóc &amp; Phục hồi" />
                                <option value="Màu nhuộm &amp; Kỹ thuật" />
                                <option value="Kiến thức tóc" />
                                <option value="Tin tức Salon" />
                            </datalist>
                        </div>

                        <div class="form-group">
                            <label asp-for="AuthorName"><strong>Tác giả</strong></label>
                            <input asp-for="AuthorName" id="blogAuthor" class="form-control" placeholder="Ví dụ: Master Ken, MC Hair Team" />
                        </div>

                        <div class="form-group">
                            <label asp-for="PublishedAt"><strong>Ngày đăng (Giờ Việt Nam)</strong></label>
                            <input asp-for="PublishedAt" id="blogPublishedAt" type="datetime-local" 
                                   value="@(Model.PublishedAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") ?? DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" 
                                   class="form-control" />
                            <small class="form-hint" style="display:block; margin-top:5px; font-size:0.8rem; color:#888;">
                                💡 <em>Nếu chọn ngày giờ tương lai, bài viết sẽ ở trạng thái <strong>Đã lên lịch</strong> và tự động hiển thị ra website khi đến đúng thời điểm đó.</em>
                            </small>
                        </div>

                        <div class="checkboxes-wrapper">
                            <label class="custom-checkbox-label">
                                <input asp-for="IsPublished" id="blogIsPublished" type="checkbox" /> 
                                <span>Xuất bản công khai</span>
                            </label>
                            <label class="custom-checkbox-label">
                                <input asp-for="IsFeatured" id="blogIsFeatured" type="checkbox" /> 
                                <span>Đặt làm Bài viết Nổi bật</span>
                            </label>
                        </div>

                        <div class="sidebar-action-buttons">
                            <button type="submit" class="btn btn-primary btn-block">💾 Lưu bài viết</button>
                            <a asp-action="Index" class="btn btn-outline btn-block">Hủy bỏ</a>
                        </div>
                    </div>

                    <!-- Thumbnail Box -->
                    <div class="admin-card sidebar-box">
                        <h3 class="box-title">Ảnh bìa / Thumbnail</h3>
                        @await Html.PartialAsync("_ImageUploadField", Model.ThumbnailUrl, new ViewDataDictionary(ViewData) { { "ImageLabel", "Chọn ảnh bìa đại diện" }, { "ImageFieldName", "ThumbnailUrl" } })
                    </div>

                    <!-- YouTube Video Box -->
                    <div class="admin-card sidebar-box">
                        <h3 class="box-title">🎬 Video YouTube</h3>
                        <div class="form-group">
                            <label asp-for="VideoUrl"><strong>Đường dẫn Video YouTube</strong></label>
                            <input asp-for="VideoUrl" id="blogVideoUrl" class="form-control" 
                                   placeholder="https://www.youtube.com/watch?v=... hoặc youtu.be/..." />
                            <p class="field-hint" style="margin-top: 0.4rem; font-size: 0.82rem; color: var(--muted);">
                                💡 Gắn link YouTube (Watch, Shorts, Share). Video phát trực tiếp từ YouTube mà không tốn dung lượng máy chủ.
                            </p>
                        </div>

                        <div id="videoPreviewContainer" class="video-preview-wrapper" style="display: @(string.IsNullOrWhiteSpace(Model.VideoUrl) ? "none" : "block"); margin-top: 0.75rem;">
                            <span class="preview-label" style="display:block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem; color: var(--brand);">Xem trước Video:</span>
                            <div class="video-embed-ratio" style="position: relative; width: 100%; aspect-ratio: 16/9; border-radius: 8px; overflow: hidden; background: #000;">
                                <iframe id="videoPreviewIframe" src="@(YouTubeHelper.ToEmbedUrl(Model.VideoUrl) ?? "")" 
                                        style="position: absolute; top:0; left:0; width:100%; height:100%; border:0;" 
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                        allowfullscreen>
                                </iframe>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline" id="btnRemoveVideo" style="margin-top: 0.5rem; color: #b71c1c; border-color: #f5c6cb; width: 100%;">
                                🗑 Xóa liên kết video
                            </button>
                        </div>
                    </div>

                    <!-- SEO Box -->
                    <div class="admin-card sidebar-box">
                        <h3 class="box-title">Cấu hình SEO Google</h3>
                        <div class="form-group">
                            <label asp-for="MetaTitle">Tiêu đề SEO (Meta Title)</label>
                            <input asp-for="MetaTitle" placeholder="Để trống nếu lấy theo Tiêu đề" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="MetaDescription">Mô tả SEO (Meta Description)</label>
                            <textarea asp-for="MetaDescription" rows="2" placeholder="Để trống nếu lấy theo Tóm tắt" class="form-control"></textarea>
                        </div>
                        <div class="form-group">
                            <label asp-for="MetaKeywords">Từ khóa SEO (Keywords)</label>
                            <input asp-for="MetaKeywords" placeholder="nhuộm balayage, phục hồi olaplex..." class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- LIVE PREVIEW PANEL (FULL SCREEN PREVIEW) -->
    <div id="panelPreviewView" class="view-panel">
        <div class="preview-toolbar">
            <div class="preview-device-switch">
                <button type="button" class="device-btn is-active" data-device="desktop">💻 Màn hình lớn (Desktop)</button>
                <button type="button" class="device-btn" data-device="mobile">📱 Điện thoại (Mobile)</button>
            </div>
            <div class="preview-notice">
                <span class="pulse-dot"></span> Đang xem trước theo thời gian thực (Live Preview)
            </div>
        </div>

        <div class="preview-frame-container" id="previewFrameContainer">
            <div class="preview-window">
                <article class="article-detail-page preview-article-root">
                    <header class="article-header">
                        <div class="container article-container">
                            <nav class="breadcrumb-nav">
                                <span>Trang chủ</span>
                                <span class="breadcrumb-separator">/</span>
                                <span>Tin tức &amp; Blog</span>
                                <span class="breadcrumb-separator">/</span>
                                <span id="pvCategoryBreadcrumb">Xu hướng tóc</span>
                                <span class="breadcrumb-separator">/</span>
                                <span class="breadcrumb-current" id="pvTitleBreadcrumb">Tiêu đề bài viết</span>
                            </nav>

                            <div class="article-meta-badge">
                                <span class="category-tag" id="pvCategoryTag">Xu hướng tóc</span>
                                <span class="featured-tag" id="pvFeaturedTag" style="display:none;">★ Nổi bật</span>
                            </div>

                            <h1 class="article-title" id="pvTitle">Tiêu đề bài viết</h1>

                            <div class="article-info-bar">
                                <div class="author-badge">
                                    <span class="author-avatar">✂</span>
                                    <span class="author-name" id="pvAuthor">MC Hair Team</span>
                                </div>
                                <span class="info-dot">•</span>
                                <time class="publish-time" id="pvDate">Hôm nay</time>
                                <span class="info-dot">•</span>
                                <span class="view-count">👁 1 lượt xem</span>
                            </div>
                        </div>
                    </header>

                    <div class="container article-container" id="pvVideoWrapper" style="display:none; margin-bottom: 2rem;">
                        <div class="article-video-wrapper" style="background:#000; border-radius:8px; overflow:hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
                            <div class="video-embed-responsive" style="position:relative; width:100%; aspect-ratio:16/9;">
                                <iframe id="pvVideoIframe" src="" style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;" frameborder="0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                            </div>
                        </div>
                    </div>

                    <div class="container article-container" id="pvCoverWrapper">
                        <figure class="article-featured-image">
                            <img id="pvCoverImage" src="/resources/dich_vu/nhuom_thiet_ke.jpg" alt="Preview Cover" />
                        </figure>
                    </div>

                    <div class="container article-container article-layout">
                        <div class="article-main-content">
                            <div class="article-summary-lead" id="pvSummaryWrapper">
                                <p id="pvSummary">Tóm tắt bài viết...</p>
                            </div>

                            <div class="article-rich-body" id="pvContent">
                                <!-- Rich content will be injected here -->
                            </div>

                            <!-- Salon CTA Booking Banner Inside Post -->
                            <div class="article-cta-box">
                                <div class="cta-inner">
                                    <div class="cta-copy">
                                        <h3>Bạn muốn thay đổi kiểu tóc hoặc phục hồi mái tóc hư tổn?</h3>
                                        <p>Đến với MC Hair Salon để được Master Stylist khám chất tóc và tư vấn kiểu tóc tôn nét đẹp riêng của bạn hoàn toàn miễn phí.</p>
                                    </div>
                                    <div class="cta-actions">
                                        <button type="button" class="btn btn-primary btn-cta-book">Đặt lịch hẹn ngay</button>
                                        <a href="tel:0988305371" class="btn btn-outline btn-cta-call">
                                            📞 Hotline: 0988 305 371
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Social Share Bar -->
                            <div class="article-share-bar">
                                <span class="share-label">Chia sẻ bài viết:</span>
                                <div class="share-buttons">
                                    <span class="share-btn share-fb">Facebook</span>
                                    <span class="share-btn share-copy">📋 Sao chép link</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL CHÈN ẢNH (HỖ TRỢ CẢ TẢI TỪ MÁY TÍNH & LINK GOOGLE DRIVE / URL)
     ========================================================================= -->
<div id="imageInsertModal" class="img-modal-backdrop" style="display:none;">
    <div class="img-modal-dialog">
        <div class="img-modal-header">
            <h3 class="img-modal-title">📷 Chèn hình ảnh vào bài viết</h3>
            <button type="button" class="img-modal-close" id="btnCloseImageModal">&times;</button>
        </div>

        <!-- Modal Tabs -->
        <div class="img-modal-tabs">
            <button type="button" class="img-tab-btn is-active" data-tab="uploadTab">
                💻 Tải ảnh từ máy tính
            </button>
            <button type="button" class="img-tab-btn" data-tab="urlTab">
                🌐 Link ảnh / Google Drive
            </button>
        </div>

        <div class="img-modal-body">
            <!-- TAB 1: UPLOAD FROM COMPUTER -->
            <div id="uploadTab" class="img-tab-content is-active">
                <div class="upload-dropzone" id="modalDropzone">
                    <div class="dropzone-icon">📁</div>
                    <h4>Kéo &amp; thả file ảnh vào đây</h4>
                    <p>Hoặc bấm nút bên dưới để chọn file từ máy tính (JPG, PNG, WEBP, GIF)</p>
                    <label class="btn btn-primary btn-file-picker">
                        Chọn file ảnh từ máy
                        <input type="file" id="modalFileInput" accept="image/*" style="display:none;" />
                    </label>
                </div>
                <div id="uploadStatusMsg" class="upload-status-msg" style="display:none;"></div>
            </div>

            <!-- TAB 2: URL & GOOGLE DRIVE -->
            <div id="urlTab" class="img-tab-content">
                <div class="form-group">
                    <label><strong>Đường dẫn hình ảnh (URL) hoặc Link chia sẻ Google Drive:</strong></label>
                    <input type="text" id="inputImageUrl" class="form-control" 
                           placeholder="https://drive.google.com/file/d/... hoặc https://example.com/anh.jpg" />
                    <p class="field-hint">
                        💡 <strong>Google Drive:</strong> Bạn chỉ cần copy link chia sẻ (Bật quyền <em>Bất kỳ ai có liên kết đều có thể xem</em>) rồi dán vào đây, hệ thống sẽ tự động nhận diện và tải ảnh!
                    </p>
                </div>

                <div class="form-group checkbox-group">
                    <label class="custom-checkbox-label">
                        <input type="checkbox" id="chkDownloadToSalon" checked />
                        <span>Tải ảnh về lưu trữ trên máy chủ Salon (Khuyên dùng để load siêu tốc &amp; không lo hỏng link)</span>
                    </label>
                </div>

                <div class="url-preview-box" id="urlPreviewBox" style="display:none;">
                    <span class="preview-label">Xem trước hình ảnh:</span>
                    <img id="imgUrlPreview" src="" alt="Preview" />
                </div>

                <div id="urlStatusMsg" class="upload-status-msg" style="display:none;"></div>
            </div>
        </div>

        <div class="img-modal-footer">
            <button type="button" class="btn btn-outline" id="btnCancelImageModal">Hủy bỏ</button>
            <button type="button" class="btn btn-primary" id="btnConfirmInsertImage" style="display:none;">Chèn ảnh vào bài viết</button>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL CHÈN VIDEO YOUTUBE VÀO BÀI VIẾT
     ========================================================================= -->
<div id="videoInsertModal" class="img-modal-backdrop" style="display:none;">
    <div class="img-modal-dialog">
        <div class="img-modal-header">
            <h3 class="img-modal-title">🎬 Chèn Video YouTube vào bài viết</h3>
            <button type="button" class="img-modal-close" id="btnCloseVideoModal">&times;</button>
        </div>
        <div class="img-modal-body" style="padding: 1.5rem;">
            <div class="form-group">
                <label><strong>Đường dẫn Video YouTube (URL):</strong></label>
                <input type="text" id="inputModalVideoUrl" class="form-control" 
                       placeholder="https://www.youtube.com/watch?v=... hoặc https://youtu.be/..." />
                <p class="field-hint" style="margin-top: 0.5rem; font-size: 0.85rem; color: var(--muted);">
                    💡 Hỗ trợ mọi định dạng: link video thường (watch), link chia sẻ (youtu.be), YouTube Shorts, v.v. Video phát trực tiếp từ YouTube mà không tốn dung lượng máy chủ.
                </p>
            </div>

            <div id="modalVideoPreviewBox" style="display:none; margin-top: 1rem;">
                <span class="preview-label" style="display:block; font-weight: 600; margin-bottom: 0.4rem; color: var(--brand);">Xem trước video:</span>
                <div style="position: relative; width: 100%; aspect-ratio: 16/9; border-radius: 8px; overflow: hidden; background: #000;">
                    <iframe id="modalVideoPreviewIframe" src="" style="position: absolute; top:0; left:0; width:100%; height:100%; border:0;" allowfullscreen></iframe>
                </div>
            </div>


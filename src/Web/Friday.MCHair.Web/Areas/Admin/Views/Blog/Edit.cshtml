<script>
document.addEventListener('DOMContentLoaded', function () {
    const blogTitle = document.getElementById('blogTitle');
    const blogSlug = document.getElementById('blogSlug');
    const btnAutoSlug = document.getElementById('btnAutoSlug');
    const blogSummary = document.getElementById('blogSummary');
    const blogCategory = document.getElementById('blogCategory');
    const blogAuthor = document.getElementById('blogAuthor');
    const blogPublishedAt = document.getElementById('blogPublishedAt');
    const blogIsFeatured = document.getElementById('blogIsFeatured');
    const visualEditor = document.getElementById('visualEditor');
    const blogContentHidden = document.getElementById('blogContentHidden');
    const blogForm = document.getElementById('blogForm');
    const editorToolbar = document.getElementById('editorToolbar');
    const imageControlToolbar = document.getElementById('imageControlToolbar');
    const btnDeleteSelectedImage = document.getElementById('btnDeleteSelectedImage');

    // Modal elements
    const btnOpenImageModal = document.getElementById('btnOpenImageModal');
    const imageInsertModal = document.getElementById('imageInsertModal');
    const btnCloseImageModal = document.getElementById('btnCloseImageModal');
    const btnCancelImageModal = document.getElementById('btnCancelImageModal');
    const modalFileInput = document.getElementById('modalFileInput');
    const modalDropzone = document.getElementById('modalDropzone');
    const uploadStatusMsg = document.getElementById('uploadStatusMsg');
    const inputImageUrl = document.getElementById('inputImageUrl');
    const chkDownloadToSalon = document.getElementById('chkDownloadToSalon');
    const urlPreviewBox = document.getElementById('urlPreviewBox');
    const imgUrlPreview = document.getElementById('imgUrlPreview');
    const urlStatusMsg = document.getElementById('urlStatusMsg');
    const btnConfirmInsertImage = document.getElementById('btnConfirmInsertImage');

    // Tabs & Preview
    const tabEditMode = document.getElementById('tabEditMode');
    const tabPreviewMode = document.getElementById('tabPreviewMode');
    const panelEditView = document.getElementById('panelEditView');
    const panelPreviewView = document.getElementById('panelPreviewView');

    // Video sidebar elements
    const blogVideoUrl = document.getElementById('blogVideoUrl');
    const videoPreviewContainer = document.getElementById('videoPreviewContainer');
    const videoPreviewIframe = document.getElementById('videoPreviewIframe');
    const btnRemoveVideo = document.getElementById('btnRemoveVideo');

    // Video modal elements
    const btnOpenVideoModal = document.getElementById('btnOpenVideoModal');
    const videoInsertModal = document.getElementById('videoInsertModal');
    const btnCloseVideoModal = document.getElementById('btnCloseVideoModal');
    const btnCancelVideoModal = document.getElementById('btnCancelVideoModal');
    const inputModalVideoUrl = document.getElementById('inputModalVideoUrl');
    const modalVideoPreviewBox = document.getElementById('modalVideoPreviewBox');
    const modalVideoPreviewIframe = document.getElementById('modalVideoPreviewIframe');
    const modalVideoStatusMsg = document.getElementById('modalVideoStatusMsg');
    const btnConfirmInsertVideo = document.getElementById('btnConfirmInsertVideo');

    // Preview elements
    const pvTitle = document.getElementById('pvTitle');
    const pvTitleBreadcrumb = document.getElementById('pvTitleBreadcrumb');
    const pvCategoryBreadcrumb = document.getElementById('pvCategoryBreadcrumb');
    const pvCategoryTag = document.getElementById('pvCategoryTag');
    const pvFeaturedTag = document.getElementById('pvFeaturedTag');
    const pvAuthor = document.getElementById('pvAuthor');
    const pvDate = document.getElementById('pvDate');
    const pvCoverImage = document.getElementById('pvCoverImage');
    const pvCoverWrapper = document.getElementById('pvCoverWrapper');
    const pvVideoWrapper = document.getElementById('pvVideoWrapper');
    const pvVideoIframe = document.getElementById('pvVideoIframe');
    const pvSummary = document.getElementById('pvSummary');
    const pvSummaryWrapper = document.getElementById('pvSummaryWrapper');
    const pvContent = document.getElementById('pvContent');
    const previewWindow = document.querySelector('.preview-window');

    let currentlySelectedImg = null;

    // --- BULLETPROOF CURSOR DOM MARKER SYSTEM ---
    function placeCursorMarker() {
        // Remove any existing marker
        const oldMarker = document.getElementById('blog-img-cursor-marker');
        if (oldMarker) oldMarker.remove();

        const sel = window.getSelection();
        if (sel && sel.rangeCount > 0) {
            const range = sel.getRangeAt(0);
            if (visualEditor.contains(range.commonAncestorContainer) || range.commonAncestorContainer === visualEditor) {
                const marker = document.createElement('span');
                marker.id = 'blog-img-cursor-marker';
                marker.className = 'img-cursor-marker';
                marker.innerHTML = '&#8203;';
                range.insertNode(marker);
                return true;
            }
        }

        // If no selection inside editor, place marker at the end
        const marker = document.createElement('span');
        marker.id = 'blog-img-cursor-marker';
        marker.className = 'img-cursor-marker';
        marker.innerHTML = '&#8203;';
        visualEditor.appendChild(marker);
        return true;
    }

    function removeCursorMarker() {
        const marker = document.getElementById('blog-img-cursor-marker');
        if (marker) marker.remove();
    }

    function insertImageAtMarker(imageUrl) {
        const marker = document.getElementById('blog-img-cursor-marker');

        const img = document.createElement('img');
        img.src = imageUrl;
        img.alt = 'Hình ảnh bài viết';
        img.className = 'blog-content-img';

        const p = document.createElement('p');
        p.appendChild(img);

        if (marker && marker.parentNode) {
            marker.parentNode.insertBefore(p, marker);
            marker.remove();
        } else {
            visualEditor.appendChild(p);
        }

        attachImageClickHandler(img);
        selectImage(img);
        p.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // Modal Opening & Closing
    function openImageModal() {
        placeCursorMarker();
        imageInsertModal.style.display = 'flex';
        inputImageUrl.value = '';
        urlPreviewBox.style.display = 'none';
        uploadStatusMsg.style.display = 'none';
        urlStatusMsg.style.display = 'none';
        btnConfirmInsertImage.style.display = 'none';
    }

    function closeImageModal() {
        removeCursorMarker();
        imageInsertModal.style.display = 'none';
        uploadStatusMsg.style.display = 'none';
        urlStatusMsg.style.display = 'none';
    }

    if (btnOpenImageModal) {
        btnOpenImageModal.addEventListener('click', openImageModal);
    }
    if (btnCloseImageModal) {
        btnCloseImageModal.addEventListener('click', closeImageModal);
    }
    if (btnCancelImageModal) {
        btnCancelImageModal.addEventListener('click', closeImageModal);
    }

    // Modal Tab Switcher
    document.querySelectorAll('.img-tab-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.img-tab-btn').forEach(b => b.classList.remove('is-active'));
            document.querySelectorAll('.img-tab-content').forEach(c => c.classList.remove('is-active'));
            this.classList.add('is-active');
            const tabId = this.getAttribute('data-tab');
            document.getElementById(tabId).classList.add('is-active');

            if (tabId === 'urlTab' && inputImageUrl.value.trim()) {
                btnConfirmInsertImage.style.display = 'inline-block';
            } else {
                btnConfirmInsertImage.style.display = tabId === 'urlTab' ? 'inline-block' : 'none';
            }
        });
    });

    // Upload from file
    async function handleFileUpload(file) {
        if (!file || !file.type.startsWith('image/')) {
            uploadStatusMsg.textContent = 'Vui lòng chọn file hình ảnh (jpg, png, webp, gif).';
            uploadStatusMsg.className = 'upload-status-msg is-error';
            uploadStatusMsg.style.display = 'block';
            return;
        }

        uploadStatusMsg.textContent = '⏳ Đang tải ảnh lên máy chủ salon...';
        uploadStatusMsg.className = 'upload-status-msg is-loading';
        uploadStatusMsg.style.display = 'block';

        const formData = new FormData();
        formData.append('upload', file);

        try {
            const res = await fetch('/Admin/Blog/UploadContentImage', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();

            if (data.url) {
                insertImageAtMarker(data.url);
                closeImageModal();
            } else {
                uploadStatusMsg.textContent = 'Lỗi tải ảnh: ' + (data.error || 'Không thể upload.');
                uploadStatusMsg.className = 'upload-status-msg is-error';
            }
        } catch (err) {
            uploadStatusMsg.textContent = 'Lỗi kết nối khi tải ảnh lên máy chủ.';
            uploadStatusMsg.className = 'upload-status-msg is-error';
        }
    }

    if (modalFileInput) {
        modalFileInput.addEventListener('change', async function () {
            if (this.files && this.files.length > 0) {
                await handleFileUpload(this.files[0]);
                this.value = '';
            }
        });
    }

    // Modal Dropzone
    if (modalDropzone) {
        modalDropzone.addEventListener('dragover', e => {
            e.preventDefault();
            modalDropzone.classList.add('is-dragover');
        });
        modalDropzone.addEventListener('dragleave', () => {
            modalDropzone.classList.remove('is-dragover');
        });
        modalDropzone.addEventListener('drop', async e => {
            e.preventDefault();
            modalDropzone.classList.remove('is-dragover');
            if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                await handleFileUpload(e.dataTransfer.files[0]);
            }
        });
    }

    // URL & Google Drive Image handling
    function convertGoogleDriveUrl(url) {
        if (!url) return '';
        const match = url.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/) ||
                      url.match(/drive\.google\.com\/.*[?&]id=([a-zA-Z0-9_-]+)/);
        if (match) {
            return `https://lh3.googleusercontent.com/d/${match[1]}`;
        }
        return url.trim();
    }

    if (inputImageUrl) {
        inputImageUrl.addEventListener('input', function () {
            const rawUrl = this.value.trim();
            if (rawUrl) {
                btnConfirmInsertImage.style.display = 'inline-block';
                const directUrl = convertGoogleDriveUrl(rawUrl);
                imgUrlPreview.src = directUrl;
                urlPreviewBox.style.display = 'block';
            } else {
                urlPreviewBox.style.display = 'none';
            }
        });
    }

    if (btnConfirmInsertImage) {
        btnConfirmInsertImage.addEventListener('click', async function () {
            const urlVal = inputImageUrl.value.trim();
            if (!urlVal) {
                alert('Vui lòng nhập đường dẫn hình ảnh.');
                return;
            }

            urlStatusMsg.textContent = '⏳ Đang xử lý & nạp hình ảnh...';
            urlStatusMsg.className = 'upload-status-msg is-loading';
            urlStatusMsg.style.display = 'block';
            btnConfirmInsertImage.disabled = true;

            const shouldDownload = chkDownloadToSalon.checked;

            try {
                const res = await fetch('/Admin/Blog/InsertImageByUrl', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url: urlVal, downloadToSalon: shouldDownload })
                });
                const data = await res.json();

                if (data.url) {
                    insertImageAtMarker(data.url);
                    closeImageModal();
                } else {
                    urlStatusMsg.textContent = 'Lỗi nạp ảnh: ' + (data.error || 'Không thể nạp link ảnh.');
                    urlStatusMsg.className = 'upload-status-msg is-error';
                }
            } catch (err) {
                // Fallback direct URL on error
                const directUrl = convertGoogleDriveUrl(urlVal);
                insertImageAtMarker(directUrl);
                closeImageModal();
            } finally {
                btnConfirmInsertImage.disabled = false;
            }
        });
    }

    // --- YOUTUBE HELPER & MODAL SYSTEM ---
    function getYouTubeEmbedUrl(url) {
        if (!url || !url.trim()) return null;
        const trimmed = url.trim();
        if (/^[\w-]{11}$/.test(trimmed)) {
            return `https://www.youtube-nocookie.com/embed/${trimmed}`;
        }
        const match = trimmed.match(/(?:https?:\/\/)?(?:www\.|m\.)?(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|v\/|shorts\/|live\/)|youtu\.be\/)([\w-]{11})/i);
        return match ? `https://www.youtube-nocookie.com/embed/${match[1]}` : null;
    }

    function updateSidebarVideoPreview() {
        if (!blogVideoUrl) return;
        const embedUrl = getYouTubeEmbedUrl(blogVideoUrl.value);
        if (embedUrl) {
            videoPreviewIframe.src = embedUrl;
            videoPreviewContainer.style.display = 'block';
        } else {
            videoPreviewIframe.src = '';
            videoPreviewContainer.style.display = 'none';
        }
    }

    if (blogVideoUrl) {
        blogVideoUrl.addEventListener('input', updateSidebarVideoPreview);
        blogVideoUrl.addEventListener('change', updateSidebarVideoPreview);
    }

    if (btnRemoveVideo) {
        btnRemoveVideo.addEventListener('click', function () {
            if (blogVideoUrl) {
                blogVideoUrl.value = '';
                updateSidebarVideoPreview();
            }
        });
    }

    // Video modal
    function openVideoModal() {
        placeCursorMarker();
        videoInsertModal.style.display = 'flex';
        inputModalVideoUrl.value = '';
        modalVideoPreviewBox.style.display = 'none';
        modalVideoStatusMsg.style.display = 'none';
        btnConfirmInsertVideo.style.display = 'none';
    }

    function closeVideoModal() {
        removeCursorMarker();
        videoInsertModal.style.display = 'none';
        modalVideoStatusMsg.style.display = 'none';
    }

    if (btnOpenVideoModal) {
        btnOpenVideoModal.addEventListener('click', openVideoModal);
    }
    if (btnCloseVideoModal) {
        btnCloseVideoModal.addEventListener('click', closeVideoModal);
    }
    if (btnCancelVideoModal) {
        btnCancelVideoModal.addEventListener('click', closeVideoModal);
    }

    if (inputModalVideoUrl) {
        inputModalVideoUrl.addEventListener('input', function () {
            const embedUrl = getYouTubeEmbedUrl(this.value);
            if (embedUrl) {
                modalVideoPreviewIframe.src = embedUrl;
                modalVideoPreviewBox.style.display = 'block';
                modalVideoStatusMsg.textContent = '✓ Nhận diện video YouTube hợp lệ';
                modalVideoStatusMsg.className = 'upload-status-msg is-loading';
                modalVideoStatusMsg.style.background = '#e8f5e9';
                modalVideoStatusMsg.style.color = '#2e7d32';
                modalVideoStatusMsg.style.borderColor = '#c8e6c9';
                modalVideoStatusMsg.style.display = 'block';
                btnConfirmInsertVideo.style.display = 'inline-block';
            } else if (this.value.trim().length > 5) {
                modalVideoPreviewBox.style.display = 'none';
                modalVideoStatusMsg.textContent = 'Link YouTube không đúng định dạng. Vui lòng kiểm tra lại.';
                modalVideoStatusMsg.className = 'upload-status-msg is-error';
                modalVideoStatusMsg.style.display = 'block';
                btnConfirmInsertVideo.style.display = 'none';
            } else {
                modalVideoPreviewBox.style.display = 'none';
                modalVideoStatusMsg.style.display = 'none';
                btnConfirmInsertVideo.style.display = 'none';
            }
        });
    }

    if (btnConfirmInsertVideo) {
        btnConfirmInsertVideo.addEventListener('click', function () {
            const embedUrl = getYouTubeEmbedUrl(inputModalVideoUrl.value);
            if (!embedUrl) return;

            const marker = document.getElementById('blog-img-cursor-marker');

            const videoBox = document.createElement('div');
            videoBox.className = 'embedded-video-wrapper';

            const iframe = document.createElement('iframe');
            iframe.src = embedUrl;
            iframe.setAttribute('allowfullscreen', 'true');
            iframe.setAttribute('loading', 'lazy');
            iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');

            videoBox.appendChild(iframe);

            const p = document.createElement('p');
            p.innerHTML = '<br>';

            if (marker && marker.parentNode) {
                marker.parentNode.insertBefore(videoBox, marker);
                marker.parentNode.insertBefore(p, marker);
                marker.remove();
            } else {
                visualEditor.appendChild(videoBox);
                visualEditor.appendChild(p);
            }

            closeVideoModal();
            videoBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
    }

    // --- DIRECT DRAG & DROP ONTO EDITOR ---
    visualEditor.addEventListener('dragover', function (e) {
        e.preventDefault();
        visualEditor.classList.add('is-dragover');
    });

    visualEditor.addEventListener('dragleave', function () {
        visualEditor.classList.remove('is-dragover');
    });

    visualEditor.addEventListener('drop', async function (e) {
        e.preventDefault();
        visualEditor.classList.remove('is-dragover');
        if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            const file = e.dataTransfer.files[0];
            if (file.type.startsWith('image/')) {
                if (document.caretRangeFromPoint) {
                    const range = document.caretRangeFromPoint(e.clientX, e.clientY);
                    if (range) {
                        const sel = window.getSelection();
                        sel.removeAllRanges();
                        sel.addRange(range);
                    }
                }
                placeCursorMarker();
                await handleFileUpload(file);
            }
        }
    });

    // --- DIRECT CLIPBOARD PASTE (Ctrl + V) ---
    visualEditor.addEventListener('paste', async function (e) {
        const items = (e.clipboardData || window.clipboardData).items;
        if (!items) return;
        for (let i = 0; i < items.length; i++) {
            if (items[i].type.indexOf('image') !== -1) {
                const file = items[i].getAsFile();
                if (file) {
                    e.preventDefault();
                    placeCursorMarker();
                    await handleFileUpload(file);
                    break;
                }
            }
        }
    });

    // --- AUTO SLUG GENERATOR ---
    function generateSlug(text) {
        if (!text) return '';
        let str = text.trim().toLowerCase();
        str = str.replace(/[áàảãạăắằẳẵặâấầẩẫậ]/g, 'a');
        str = str.replace(/[éèẻẽẹêếềểễệ]/g, 'e');
        str = str.replace(/[iíìỉĩị]/g, 'i');
        str = str.replace(/[óòỏõọôốồổỗộơớờởỡợ]/g, 'o');
        str = str.replace(/[úùủũụưứừửữự]/g, 'u');
        str = str.replace(/[ýỳỷỹỵ]/g, 'y');
        str = str.replace(/[đ]/g, 'd');
        str = str.replace(/[^a-z0-9\s-]/g, '');
        str = str.replace(/\s+/g, '-');
        str = str.replace(/-+/g, '-');
        return str.replace(/^-+|-+$/g, '');
    }

    if (btnAutoSlug) {
        btnAutoSlug.addEventListener('click', function () {
            if (blogTitle.value) {
                blogSlug.value = generateSlug(blogTitle.value);
            }
        });
    }

    if (blogTitle && !blogSlug.value) {
        blogTitle.addEventListener('blur', function () {
            if (!blogSlug.value && blogTitle.value) {
                blogSlug.value = generateSlug(blogTitle.value);
            }
        });
    }

    // Formatting commands
    editorToolbar.querySelectorAll('.toolbar-btn[data-cmd]').forEach(btn => {
        btn.addEventListener('click', function () {
            const cmd = this.getAttribute('data-cmd');
            const val = this.getAttribute('data-val') || null;
            document.execCommand(cmd, false, val);
            visualEditor.focus();
        });
    });

    // Insert Link
    const btnInsertLink = document.getElementById('btnInsertLink');
    if (btnInsertLink) {
        btnInsertLink.addEventListener('click', function () {
            const url = prompt('Nhập địa chỉ liên kết (URL):', 'https://');
            if (url) {
                document.execCommand('createLink', false, url);
                visualEditor.focus();
            }
        });
    }

    // --- IMAGE CLICK & FLOATING TOOLBAR ---
    function attachImageClickHandler(img) {
        img.addEventListener('click', function (e) {
            e.stopPropagation();
            selectImage(img);
        });
    }

    function selectImage(img) {
        deselectAllImages();
        currentlySelectedImg = img;
        img.classList.add('is-selected');

        const topPos = img.offsetTop - 45;
        const leftPos = Math.max(10, img.offsetLeft);

        imageControlToolbar.style.top = (topPos > 0 ? topPos : img.offsetTop + 10) + 'px';
        imageControlToolbar.style.left = leftPos + 'px';
        imageControlToolbar.style.display = 'flex';
    }

    function deselectAllImages() {
        visualEditor.querySelectorAll('img.is-selected').forEach(el => el.classList.remove('is-selected'));
        currentlySelectedImg = null;
        imageControlToolbar.style.display = 'none';
    }

    visualEditor.querySelectorAll('img').forEach(attachImageClickHandler);

    document.addEventListener('click', function (e) {
        if (!imageControlToolbar.contains(e.target) && e.target.tagName !== 'IMG') {
            deselectAllImages();
        }
    });

    imageControlToolbar.querySelectorAll('.img-tb-btn[data-size]').forEach(btn => {
        btn.addEventListener('click', function () {
            if (!currentlySelectedImg) return;
            const size = this.getAttribute('data-size');
            currentlySelectedImg.classList.remove('size-50', 'size-75');
            if (size === '50%') currentlySelectedImg.classList.add('size-50');
            else if (size === '75%') currentlySelectedImg.classList.add('size-75');
        });
    });

    imageControlToolbar.querySelectorAll('.img-tb-btn[data-align]').forEach(btn => {
        btn.addEventListener('click', function () {
            if (!currentlySelectedImg) return;
            const align = this.getAttribute('data-align');
            currentlySelectedImg.classList.remove('align-left', 'align-right');
            if (align === 'left') currentlySelectedImg.classList.add('align-left');
            else if (align === 'right') currentlySelectedImg.classList.add('align-right');
        });
    });

    if (btnDeleteSelectedImage) {
        btnDeleteSelectedImage.addEventListener('click', function () {
            if (currentlySelectedImg) {
                currentlySelectedImg.remove();
                deselectAllImages();
            }
        });
    }

    // HTML Source Mode toggle
    let isHtmlMode = false;
    const btnToggleHtml = document.getElementById('btnToggleHtml');
    if (btnToggleHtml) {
        btnToggleHtml.addEventListener('click', function () {
            isHtmlMode = !isHtmlMode;
            if (isHtmlMode) {
                deselectAllImages();
                visualEditor.innerText = visualEditor.innerHTML;
                this.textContent = 'Trực quan (WYSIWYG)';
                this.style.background = '#ffd8a8';
            } else {
                visualEditor.innerHTML = visualEditor.innerText;
                visualEditor.querySelectorAll('img').forEach(attachImageClickHandler);
                this.textContent = 'HTML';
                this.style.background = '';
            }
        });
    }

    // Live Preview Synchronization Function
    function syncLivePreview() {
        const titleVal = blogTitle.value.trim() || 'Tiêu đề bài viết';
        const catVal = blogCategory.value.trim() || 'Xu hướng tóc';
        const authorVal = blogAuthor.value.trim() || 'MC Hair Team';
        const summaryVal = blogSummary.value.trim();
        
        let contentHtml = visualEditor.innerHTML;
        if (isHtmlMode) {
            contentHtml = visualEditor.innerText;
        }

        pvTitle.textContent = titleVal;
        pvTitleBreadcrumb.textContent = titleVal;
        pvCategoryBreadcrumb.textContent = catVal;
        pvCategoryTag.textContent = catVal;
        pvAuthor.textContent = authorVal;

        if (blogIsFeatured && blogIsFeatured.checked) {
            pvFeaturedTag.style.display = 'inline-block';
        } else {
            pvFeaturedTag.style.display = 'none';
        }

        if (blogPublishedAt && blogPublishedAt.value) {
            const d = new Date(blogPublishedAt.value);
            pvDate.textContent = isNaN(d) ? 'Hôm nay' : d.toLocaleDateString('vi-VN');
        }

        const imgInput = document.querySelector('input[name="ThumbnailUrl"]');
        const imgPreview = document.querySelector('.image-upload-field .image-preview');
        
        let hasVideo = false;
        if (blogVideoUrl && blogVideoUrl.value.trim()) {
            const embedUrl = getYouTubeEmbedUrl(blogVideoUrl.value);
            if (embedUrl) {
                pvVideoIframe.src = embedUrl;
                pvVideoWrapper.style.display = 'block';
                hasVideo = true;
            }
        }
        
        if (!hasVideo) {
            pvVideoIframe.src = '';
            pvVideoWrapper.style.display = 'none';
        }

        if (imgPreview && imgPreview.src) {
            pvCoverImage.src = imgPreview.src;
            pvCoverWrapper.style.display = hasVideo ? 'none' : 'block';
        } else if (imgInput && imgInput.value.trim()) {
            pvCoverImage.src = imgInput.value.trim();
            pvCoverWrapper.style.display = hasVideo ? 'none' : 'block';
        } else {
            pvCoverWrapper.style.display = 'none';
        }

        if (summaryVal) {
            pvSummary.textContent = summaryVal;
            pvSummaryWrapper.style.display = 'block';
        } else {
            pvSummaryWrapper.style.display = 'none';
        }

        pvContent.innerHTML = contentHtml || '<p style="color:#999; font-style:italic;">(Nội dung bài viết chưa có văn bản nào)</p>';
    }

    // Tab switcher events
    tabEditMode.addEventListener('click', function () {
        tabEditMode.classList.add('is-active');
        tabPreviewMode.classList.remove('is-active');
        panelEditView.classList.add('is-active');
        panelPreviewView.classList.remove('is-active');
    });

    tabPreviewMode.addEventListener('click', function () {
        syncLivePreview();
        tabPreviewMode.classList.add('is-active');
        tabEditMode.classList.remove('is-active');
        panelPreviewView.classList.add('is-active');
        panelEditView.classList.remove('is-active');
    });

    // Device switch buttons in preview mode
    document.querySelectorAll('.device-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.device-btn').forEach(b => b.classList.remove('is-active'));
            this.classList.add('is-active');
            const dev = this.getAttribute('data-device');
            if (dev === 'mobile') {
                previewWindow.classList.add('is-mobile');
            } else {
                previewWindow.classList.remove('is-mobile');
            }
        });
    });

    // Sync content to hidden textarea on form submit
    if (blogForm) {
        blogForm.addEventListener('submit', function () {
            deselectAllImages();
            removeCursorMarker();
            if (isHtmlMode) {
                visualEditor.innerHTML = visualEditor.innerText;
            }
            blogContentHidden.value = visualEditor.innerHTML;
        });
    }
});
</script>

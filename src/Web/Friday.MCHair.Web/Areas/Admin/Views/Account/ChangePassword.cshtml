@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="admin-card" style="max-width: 500px; background: #fff; padding: 2rem; border-radius: 8px; border: 1px solid #e5e7eb; margin-top: 1.5rem;">
    <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; color: #111827;">🔑 Thay đổi mật khẩu cá nhân</h2>
    <p style="font-size: 0.88rem; color: #6b7280; margin-bottom: 1.5rem;">
        Đang đăng nhập với tài khoản: <strong>@User.Identity?.Name</strong> (@User.FindFirst("display_name")?.Value)
    </p>

    @if (ViewBag.Error is string err)
    {
        <div class="alert error" style="margin-bottom: 1.25rem;">@err</div>
    }

    <form asp-action="ChangePassword" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        
        <div class="form-group">
            <label style="font-weight: 600;">Mật khẩu hiện tại <span class="text-danger">*</span></label>
            <input type="password" name="currentPassword" required placeholder="Nhập mật khẩu bạn đang sử dụng..." autocomplete="current-password" />
        </div>

        <div class="form-group">
            <label style="font-weight: 600;">Mật khẩu mới <span class="text-danger">*</span></label>
            <input type="password" name="newPassword" required placeholder="Tối thiểu 6 ký tự..." autocomplete="new-password" minlength="6" />
        </div>

        <div class="form-group">
            <label style="font-weight: 600;">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
            <input type="password" name="confirmPassword" required placeholder="Nhập lại mật khẩu mới..." autocomplete="new-password" minlength="6" />
        </div>

        <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
            <button type="submit" class="btn btn-primary">💾 Cập nhật mật khẩu</button>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
        </div>
    </form>
</div>

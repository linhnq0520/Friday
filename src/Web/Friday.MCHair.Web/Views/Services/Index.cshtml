@model ServicesIndexViewModel
@using Friday.MCHair.Web.Localization
@{
    var openingHours = Model.Settings.GetValueOrDefault("opening_hours", "08:30 – 20:00");
    var hotline = Model.Settings.GetValueOrDefault("hotline", "0988305371");
    bool isEn = CultureHelper.IsEnglish;
}

<section class="page-hero price-hero">
    <div class="container">
        <p class="eyebrow eyebrow-dark">MC Hair Salon</p>
        <h1>@Localizer["Services_Title"]</h1>
        <p class="lead">@Localizer["Services_Lead"]</p>
        <div class="price-meta">
            <span>@Localizer["Services_OpeningHours"] <strong>@openingHours</strong></span>
            <span>@Localizer["Common_Hotline"] <strong>@hotline</strong></span>
            <a href="@SiteContent.FacebookUrl" target="_blank" rel="noopener noreferrer">Facebook</a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <p class="price-note">@Model.PriceList.PriceUnitNote</p>

        <div class="price-columns">
            @foreach (var column in Model.PriceList.ToColumns())
            {
                <div class="price-column">
                    @foreach (var group in column.Groups)
                    {
                        <article class="price-group">
                            <h2>@group.Title</h2>
                            <table class="price-table">
                                <tbody>
                                    @foreach (var item in group.Items)
                                    {
                                        <tr>
                                            <th scope="row">@item.Name</th>
                                            <td>@item.Price</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </article>
                    }
                </div>
            }
        </div>

        <article class="price-group price-length-guide">
            <h2>@Localizer["Services_SizeGuideTitle"]</h2>
            <p class="muted">@Localizer["Services_SizeGuideLead"]</p>
            <div class="length-grid">
                @foreach (var size in Model.PriceList.LengthGuide)
                {
                    <div class="length-item">
                        <span class="length-badge">@size.Size</span>
                        <span>@size.Description</span>
                    </div>
                }
            </div>
        </article>
    </div>
</section>

@if (Model.Services.Count > 0)
{
    <section class="section section-alt">
        <div class="container">
            <div class="section-head center">
                <h2>@Localizer["Services_QuickBookingTitle"]</h2>
                <p>@Localizer["Services_QuickBookingLead"]</p>
            </div>
            <div class="card-grid four">
                @foreach (var service in Model.Services)
                {
                    <article class="card service-card">
                        <h3>@CatalogTranslations.ServiceName(service.Name, isEn)</h3>
                        <p>@CatalogTranslations.ServiceDescription(service.Name, service.Description, isEn)</p>
                        <p class="price">@Localizer["Common_PriceFrom"] <strong>@service.PriceFrom.ToString("N0")</strong> @(isEn ? "VND" : "đ")</p>
                        @await Component.InvokeAsync("BookingLink", new { cssClass = "btn btn-primary", label = Localizer["Nav_Booking"].Value, serviceId = service.Id })
                    </article>
                }
            </div>
        </div>
    </section>
}

<section class="section section-cta">
    <div class="container center">
        <h2>@Localizer["Services_CtaTitle"]</h2>
        <p>@Localizer["Services_CtaLead"]</p>
        @await Component.InvokeAsync("BookingLink", new { cssClass = "btn btn-primary", label = Localizer["Common_BookingNow"].Value })
    </div>
</section>

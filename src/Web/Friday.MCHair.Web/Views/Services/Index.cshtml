@model ServicesHubViewModel
@using Friday.MCHair.Web.Localization
@{
    var openingHours = Model.Settings.GetValueOrDefault("opening_hours", "08:30 – 20:00");
    var hotline = Model.Settings.GetValueOrDefault("hotline", "0988305371");
    bool isEn = CultureHelper.IsEnglish;
}

<nav class="breadcrumb-container" aria-label="Breadcrumb">
    <div class="container">
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Index">@Localizer["Nav_Home"]</a></li>
            <li aria-current="page">@Localizer["Nav_Services"]</li>
        </ol>
    </div>
</nav>

<!-- Service Hub Hero -->
<section class="svc-hub-hero">
    <div class="container">
        <div class="svc-hub-hero-grid">
            <div class="svc-hub-hero-text">
                <span class="badge-eyebrow">Tất cả dịch vụ · MC Hair Salon · Q.1 TP.HCM</span>
                <h1 class="svc-hub-title">Salon tóc tận tâm,<br /><em>giá rõ từ trước</em></h1>
                <p class="svc-hub-lede">
                    Cắt · Uốn · Nhuộm · Duỗi · Nối · Phục hồi — MC Hair tư vấn 1:1 theo tỉ lệ khuôn mặt và chất tóc thực tế, cam kết báo giá minh bạch, không chèo kéo phát sinh.
                </p>
                <div class="svc-hub-btn-row">
                    @await Component.InvokeAsync("BookingLink", new { cssClass = "btn btn-primary btn-lg", label = Localizer["Common_BookingNow"].Value })
                    <a asp-controller="PriceList" asp-action="Index" class="btn btn-outline btn-lg">Xem bảng giá chi tiết →</a>
                </div>
                <div class="svc-hub-stats">
                    <div class="stat-item">
                        <span class="stat-num"><span class="stars">★★★★★</span> 5.0</span>
                        <span class="stat-label">1.000+ đánh giá Google</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-num">250+</span>
                        <span class="stat-label">lượt phục vụ / tháng</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-num">~10</span>
                        <span class="stat-label">năm kinh nghiệm stylist</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hair Condition Interactive Finder -->
        <div class="svc-finder-box" id="hairFinder">
            <h3 class="svc-finder-title">Chưa biết nên làm dịch vụ gì? <em>Thử chọn tình trạng tóc của bạn</em></h3>
            <p class="svc-finder-subtitle">Tóc bạn hiện tại đang như thế nào?</p>
            <div class="svc-pill-row">
                <button type="button" class="svc-pill" data-target="phuc-hoi-toc">Khô xơ sau tẩy/nhuộm</button>
                <button type="button" class="svc-pill" data-target="duoi-toc">Tóc rối, không vào nếp</button>
                <button type="button" class="svc-pill" data-target="nhuom-toc">Muốn đổi màu thời trang</button>
                <button type="button" class="svc-pill" data-target="uon-toc">Muốn uốn sóng / xoăn layer</button>
                <button type="button" class="svc-pill" data-target="noi-toc">Muốn tóc dài và dày hơn</button>
                <button type="button" class="svc-pill" data-target="cat-toc-nu">Muốn cắt tỉa kiểu mới</button>
                <a asp-controller="PriceList" asp-action="Index" class="svc-pill svc-pill-link">Cần xem bảng giá trước →</a>
            </div>
        </div>
    </div>
</section>

<!-- Services Grid -->
<section class="section svc-cards-section" id="danh-sach-dich-vu">
    <div class="container">
        <div class="section-head-split">
            <div>
                <span class="badge-eyebrow">Dịch vụ chuyên nghiệp</span>
                <h2 class="svc-section-heading">MC Hair có <em>những dịch vụ gì?</em></h2>
            </div>
            <a asp-controller="PriceList" asp-action="Index" class="btn btn-outline btn-sm">Xem bảng giá đầy đủ →</a>
        </div>

        <div class="svc-hub-grid">
            @foreach (var s in Model.Services)
            {
                string detailUrl = !string.IsNullOrWhiteSpace(s.Slug) ? $"/dich-vu/{s.Slug}" : $"/dich-vu/{s.Id}";
                string image = !string.IsNullOrWhiteSpace(s.ImageUrl) ? s.ImageUrl : "/resources/dich_vu/cat_toc.jpg";
                string priceText = !string.IsNullOrWhiteSpace(s.PriceTagText) ? s.PriceTagText : (s.PriceFrom > 0 ? $"Từ {s.PriceFrom:N0}đ" : "Liên hệ");
                string duration = !string.IsNullOrWhiteSpace(s.DurationText) ? s.DurationText : "1–2 giờ";
                string badge = !string.IsNullOrWhiteSpace(s.BadgeText) ? s.BadgeText : "Chuyên nghiệp";

                <article class="svc-hub-card" id="card-@(s.Slug)">
                    <a href="@detailUrl" class="svc-hub-thumb" title="@s.Name">
                        <span class="svc-pop-badge">@badge</span>
                        <img src="@image" alt="@s.Name tại MC Hair Salon" loading="lazy" />
                    </a>
                    <div class="svc-hub-body">
                        <h3><a href="@detailUrl">@s.Name</a></h3>
                        <p class="svc-hub-desc">@(s.ShortDescription ?? s.Description ?? s.Headline)</p>
                        <div class="svc-hub-meta">
                            <span class="svc-hub-price">@priceText</span>
                            <span class="svc-hub-dur">⏱ @duration</span>
                        </div>
                        <a href="@detailUrl" class="btn btn-primary svc-hub-btn">Xem chi tiết →</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- Combos Section -->
<section class="section section-alt svc-combo-section">
    <div class="container">
        <div class="section-head center">
            <span class="badge-eyebrow">Kết hợp hoàn hảo</span>
            <h2>Combo dịch vụ <em>hiệu quả và tiết kiệm hơn</em></h2>
            <p class="lead">Khách hàng tại MC Hair thường lựa chọn các combo này để tối ưu thời gian và chi phí.</p>
        </div>

        <div class="svc-combo-grid">
            <div class="svc-combo-card">
                <span class="combo-tag combo-tag-pop">Phổ biến nhất</span>
                <h3>Nhuộm + Phục hồi chuyên sâu</h3>
                <div class="combo-steps">
                    <div class="combo-step"><span class="step-num">1</span>Nhuộm màu thời trang chuẩn tone</div>
                    <div class="combo-step"><span class="step-num">2</span>Bọc dưỡng Olaplex & Keratin sau nhuộm</div>
                </div>
                <p class="combo-note">Giữ hạt màu bền hơn gấp đôi, bảo vệ sợi tóc luôn bóng mượt, không khô xơ.</p>
                @await Component.InvokeAsync("BookingLink", new { cssClass = "btn btn-outline btn-block", label = "Đặt combo này" })
            </div>

            <div class="svc-combo-card">
                <span class="combo-tag">Làm mới toàn diện</span>
                <h3>Cắt Layer + Uốn sóng lơi + Dưỡng</h3>
                <div class="combo-steps">
                    <div class="combo-step"><span class="step-num">1</span>Cắt tỉa phom dáng chuẩn tỉ lệ gương mặt</div>
                    <div class="combo-step"><span class="step-num">2</span>Uốn sóng lơi định hình bồng bềnh</div>
                    <div class="combo-step"><span class="step-num">3</span>Khóa nếp Collagen mềm mại tự nhiên</div>
                </div>
                <p class="combo-note">Thay đổi thần thái và diện mạo toàn diện chỉ trong một buổi làm đẹp.</p>
                @await Component.InvokeAsync("BookingLink", new { cssClass = "btn btn-outline btn-block", label = "Đặt combo này" })
            </div>

            <div class="svc-combo-card">
                <span class="combo-tag">Mái tóc trong mơ</span>
                <h3>Nối tóc + Nhuộm đồng màu + Dưỡng bóng</h3>
                <div class="combo-steps">
                    <div class="combo-step"><span class="step-num">1</span>Nối tóc dài và dày kỹ thuật lông vũ siêu vi</div>
                    <div class="combo-step"><span class="step-num">2</span>Nhuộm đồng màu hoặc light thiết kế</div>
                    <div class="combo-step"><span class="step-num">3</span>Ủ dưỡng suôn mượt toàn bộ mái tóc</div>
                </div>
                <p class="combo-note">Sở hữu mái tóc dài bồng bềnh, óng ả ngay lập tức mà không cần chờ đợi.</p>
                @await Component.InvokeAsync("BookingLink", new { cssClass = "btn btn-outline btn-block", label = "Đặt combo này" })
            </div>
        </div>
    </div>
</section>

<!-- Real Gallery Photos -->
@if (Model.GalleryItems.Count > 0)
{
    <section class="section svc-gallery-section">
        <div class="container">
            <div class="section-head-split">
                <div>
                    <span class="badge-eyebrow">Ảnh thực tế tại salon</span>
                    <h2>Tác phẩm từ <em>khách hàng thực tế</em></h2>
                    <p class="lead">Ảnh chụp thật 100% tại salon MC Hair — không chỉnh sửa quá đà, trung thực với kết quả của bạn.</p>
                </div>
                <a asp-controller="Gallery" asp-action="Index" class="btn btn-outline btn-sm">Xem toàn bộ bộ sưu tập →</a>
            </div>

            <div class="svc-gallery-grid">
                @foreach (var item in Model.GalleryItems)
                {
                    <a asp-controller="Gallery" asp-action="Index" class="svc-gal-item">
                        <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                        <span class="svc-gal-label">@item.Title</span>
                    </a>
                }
            </div>
        </div>
    </section>
}


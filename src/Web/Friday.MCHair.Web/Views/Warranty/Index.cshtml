@model WarrantyPageData
@using Friday.MCHair.Web.Models

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">MC Hair Salon</p>
        <h1>@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Lead))
        {
            <p class="lead">@Model.Lead</p>
        }
    </div>
</section>

<section class="section">
    <div class="container narrow-content">
        @foreach (var block in Model.Sections)
        {
            <div class="content-block">
                @if (!string.IsNullOrWhiteSpace(block.Title))
                {
                    <h2>@block.Title</h2>
                }
                @if (string.Equals(block.Format, "list", StringComparison.OrdinalIgnoreCase))
                {
                    <ul class="policy-list">
                        @foreach (var line in block.Body.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <li>@Html.Raw(line)</li>
                        }
                    </ul>
                }
                else if (!string.IsNullOrWhiteSpace(block.Body))
                {
                    <p>@Html.Raw(block.Body)</p>
                }
            </div>
        }
    </div>
</section>

@section Head {
    <script>
        const hotline = document.getElementById('site-hotline');
        const warrantyHotline = document.getElementById('warranty-hotline');
        if (hotline && warrantyHotline) {
            warrantyHotline.textContent = hotline.textContent;
        }
    </script>
}

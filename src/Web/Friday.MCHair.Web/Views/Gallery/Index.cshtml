@model IReadOnlyList<Friday.Modules.Salon.Application.Models.GalleryCollectionDto>
@using Friday.MCHair.Web.Models
@{
    ViewData["Title"] = "Bộ sưu tập | MC Hair Salon";
}

<section class="page-hero">
    <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Bộ sưu tập</span>
        </nav>
        <h1>Bộ sưu tập</h1>
        <p class="lead">Khám phá các bộ sưu tập mẫu tóc nổi bật tại MC Hair Salon.</p>
    </div>
</section>

<section class="section">
    <div class="container collection-grid four">
        @foreach (var collection in Model)
        {
            <a class="collection-card" asp-action="Category" asp-route-category="@((int)collection.Category)">
                <div class="collection-card-image">
                    <img src="@collection.CoverImageUrl" alt="@GalleryCategoryLabels.GetLabel(collection.Category)" loading="lazy" />
                    <span class="collection-card-overlay"></span>
                    <span class="collection-card-badge">@collection.ImageCount ảnh</span>
                </div>
                <div class="collection-card-body">
                    <h3>@GalleryCategoryLabels.GetLabel(collection.Category)</h3>
                    <span class="collection-card-link">Xem thêm →</span>
                </div>
            </a>
        }
    </div>
</section>

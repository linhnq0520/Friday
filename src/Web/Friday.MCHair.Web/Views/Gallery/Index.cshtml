@model IReadOnlyList<Friday.Modules.Salon.Application.Models.GalleryCollectionDto>
@{
    ViewData["Title"] ??= Localizer["Meta_Gallery"].Value;
}

<section class="page-hero">
    <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">@Localizer["Nav_Home"]</a>
            <span aria-hidden="true">/</span>
            <span>@Localizer["Nav_Gallery"]</span>
        </nav>
        <h1>@Localizer["Gallery_Title"]</h1>
        <p class="lead">@Localizer["Gallery_Lead"]</p>
    </div>
</section>

<section class="section">
    <div class="container collection-grid four">
        @foreach (var collection in Model)
        {
            <a class="collection-card" asp-action="Category" asp-route-category="@((int)collection.Category)">
                <div class="collection-card-image">
                    <img src="@collection.CoverImageUrl" alt="@GalleryCategoryLabels.GetLabel(collection.Category)" loading="lazy" />
                    <span class="collection-card-overlay"></span>
                    <span class="collection-card-badge">@collection.ImageCount @Localizer["Common_Images"]</span>
                </div>
                <div class="collection-card-body">
                    <h3>@GalleryCategoryLabels.GetLabel(collection.Category)</h3>
                    <span class="collection-card-link">@Localizer["Common_SeeMore"]</span>
                </div>
            </a>
        }
    </div>
</section>

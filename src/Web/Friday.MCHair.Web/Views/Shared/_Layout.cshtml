<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["MetaDescription"]" />
    <link rel="stylesheet" href="~/css/mchair.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "HairSalon",
      "name": "MCHair Salon",
      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
      "telephone": "0900123456",
      "address": {
        "@@type": "PostalAddress",
        "addressLocality": "TP.HCM",
        "addressCountry": "VN"
      }
    }
    </script>
</head>
<body>
    <div class="top-bar">
        <div class="container top-bar-inner">
            <span class="hotline">Hotline: <strong id="site-hotline">0900 123 456</strong></span>
            <div class="top-links">
                <a href="#" aria-label="Facebook">Facebook</a>
                <a href="#" aria-label="Zalo">Zalo</a>
            </div>
        </div>
    </div>

    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" asp-controller="Home" asp-action="Index">
                <span class="logo-mark">MC</span>
                <span class="logo-text">MCHair</span>
            </a>
            <button class="nav-toggle" type="button" aria-label="Menu" onclick="document.body.classList.toggle('nav-open')">☰</button>
            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a asp-controller="Services" asp-action="Index">Dịch vụ</a>
                <a asp-controller="Gallery" asp-action="Index">Bộ sưu tập</a>
                <a asp-controller="News" asp-action="Index">Tin tức</a>
                <a class="btn-book" asp-controller="Booking" asp-action="Index">Đặt lịch</a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <h3>MCHair Salon</h3>
                <p>Salon làm tóc chuyên nghiệp — cắt, nhuộm, uốn, phục hồi.</p>
            </div>
            <div>
                <h4>Liên hệ</h4>
                <p>123 Nguyễn Huệ, Q.1, TP.HCM</p>
                <p>Hotline: 0900 123 456</p>
                <p>Giờ mở cửa: 9:00 - 20:00</p>
            </div>
            <div>
                <h4>Liên kết</h4>
                <a asp-controller="Services" asp-action="Index">Bảng giá</a>
                <a asp-controller="Booking" asp-action="Index">Đặt lịch online</a>
                <a href="/sitemap.xml">Sitemap</a>
            </div>
        </div>
        <div class="container footer-bottom">
            <p>&copy; @DateTime.Now.Year MCHair Salon. All rights reserved.</p>
        </div>
    </footer>

    <a class="float-book" asp-controller="Booking" asp-action="Index">Đặt lịch</a>
    @if (ViewData["ShowBackToTop"] as bool? == true)
    {
        <button type="button" class="back-to-top" aria-label="Về đầu trang" title="Về đầu trang">↑</button>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

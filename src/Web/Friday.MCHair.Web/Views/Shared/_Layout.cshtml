<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["MetaDescription"]" />
    <meta name="google-site-verification" content="Wl2m3g0qP_w8DCxyMUrNzxEzA4QLjdwvypX-nh5P0hQ" />
    <partial name="_Favicons" />
    <link rel="stylesheet" href="~/css/mchair.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "HairSalon",
      "name": "MC Hair Salon",
      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
      "telephone": "0988305371",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "14D Cống Quỳnh",
        "addressLocality": "Phường Cầu Ông Lãnh, TP. Hồ Chí Minh",
        "addressCountry": "VN"
      }
    }
    </script>
</head>
<body>
    @await Component.InvokeAsync("SiteInfo", new { template = "TopBar" })

    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" asp-controller="Home" asp-action="Index" aria-label="MC Hair Salon">
                <span class="logo-wordmark">
                    <span class="logo-mc">MC</span>
                    <span class="logo-tagline">Hair salon</span>
                </span>
            </a>
            <button class="nav-toggle" type="button" aria-label="Menu" onclick="document.body.classList.toggle('nav-open')">☰</button>
            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a asp-controller="About" asp-action="Index">Giới thiệu</a>
                <a asp-controller="Services" asp-action="Index">Dịch vụ</a>
                <a asp-controller="Gallery" asp-action="Index">Bộ sưu tập</a>
                <a asp-controller="News" asp-action="Index">Tin tức</a>
                <a asp-controller="Warranty" asp-action="Index">Bảo hành</a>
                @await Component.InvokeAsync("BookingLink", new { cssClass = "btn-book", label = "Đặt lịch" })
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <a class="logo logo-footer" asp-controller="Home" asp-action="Index" aria-label="MC Hair Salon">
                    <span class="logo-wordmark">
                        <span class="logo-mc">MC</span>
                        <span class="logo-tagline">Hair salon</span>
                    </span>
                </a>
                <p>Salon làm tóc hiện đại — cắt, nhuộm, uốn, phục hồi tại TP.HCM.</p>
            </div>
            <div>
                @await Component.InvokeAsync("SiteInfo", new { template = "FooterContact" })
            </div>
            <div>
                <h4>Liên kết</h4>
                <a asp-controller="About" asp-action="Index">Giới thiệu</a>
                <a asp-controller="Services" asp-action="Index">Bảng giá</a>
                <a asp-controller="Gallery" asp-action="Index">Bộ sưu tập</a>
                <a asp-controller="Warranty" asp-action="Index">Chế độ bảo hành</a>
                @await Component.InvokeAsync("BookingLink", new { label = "Đặt lịch online" })
                <a href="@SiteContent.FacebookUrl" target="_blank" rel="noopener noreferrer">Fanpage Facebook</a>
                <a href="/sitemap.xml">Sitemap</a>
            </div>
        </div>
        <div class="container footer-bottom">
            <p>&copy; @DateTime.Now.Year MC Hair Salon. All rights reserved.</p>
        </div>
    </footer>

    @await Component.InvokeAsync("SiteInfo", new { template = "FloatActions" })
    @if (ViewData["ShowBackToTop"] as bool? == true)
    {
        <button type="button" class="back-to-top" aria-label="Về đầu trang" title="Về đầu trang">↑</button>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/float-actions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

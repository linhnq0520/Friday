<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','@SeoDefaults.GoogleTagManagerId');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["MetaDescription"]" />
    <meta property="og:site_name" content="@SeoDefaults.SiteName" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["MetaDescription"]" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/resources/logo.jpg")" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="google-site-verification" content="Wl2m3g0qP_w8DCxyMUrNzxEzA4QLjdwvypX-nh5P0hQ" />
    <partial name="_Favicons" />
    <link rel="stylesheet" href="~/css/mchair.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "HairSalon",
      "name": "MC Hair Salon",
      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
      "telephone": "0988305371",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "14D Cống Quỳnh",
        "addressLocality": "Phường Cầu Ông Lãnh, TP. Hồ Chí Minh",
        "addressCountry": "VN"
      }
    }
    </script>
</head>
<body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=@SeoDefaults.GoogleTagManagerId"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    @await Component.InvokeAsync("SiteInfo", new { template = "TopBar" })

    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" asp-controller="Home" asp-action="Index" aria-label="MC Hair Salon">
                <span class="logo-wordmark">
                    <span class="logo-mc">MC</span>
                    <span class="logo-tagline">Hair salon</span>
                </span>
            </a>
            <button class="nav-toggle" type="button" aria-label="@Localizer["Nav_Menu"]" onclick="document.body.classList.toggle('nav-open')">☰</button>
            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">@Localizer["Nav_Home"]</a>
                <a asp-controller="About" asp-action="Index">@Localizer["Nav_About"]</a>
                <a asp-controller="Services" asp-action="Index">@Localizer["Nav_Services"]</a>
                <a asp-controller="Gallery" asp-action="Index">@Localizer["Nav_Gallery"]</a>
                <a asp-controller="Promotions" asp-action="Index">@Localizer["Nav_Promotions"]</a>
                <a asp-controller="News" asp-action="Index">@Localizer["Nav_News"]</a>
                <a asp-controller="Warranty" asp-action="Index">@Localizer["Nav_Warranty"]</a>
                @await Component.InvokeAsync("BookingLink", new { cssClass = "btn-book", label = Localizer["Nav_Booking"].Value })
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <a class="logo logo-footer" asp-controller="Home" asp-action="Index" aria-label="MC Hair Salon">
                    <span class="logo-wordmark">
                        <span class="logo-mc">MC</span>
                        <span class="logo-tagline">Hair salon</span>
                    </span>
                </a>
                <p>@Localizer["Footer_Description"]</p>
            </div>
            <div>
                @await Component.InvokeAsync("SiteInfo", new { template = "FooterContact" })
            </div>
            <div>
                <h4>@Localizer["Footer_Links"]</h4>
                <a asp-controller="About" asp-action="Index">@Localizer["Nav_About"]</a>
                <a asp-controller="Services" asp-action="Index">@Localizer["Footer_PriceList"]</a>
                <a asp-controller="Gallery" asp-action="Index">@Localizer["Nav_Gallery"]</a>
                <a asp-controller="Promotions" asp-action="Index">@Localizer["Nav_Promotions"]</a>
                <a asp-controller="News" asp-action="Index">@Localizer["Nav_News"]</a>
                <a asp-controller="Warranty" asp-action="Index">@Localizer["Footer_WarrantyPolicy"]</a>
                @await Component.InvokeAsync("BookingLink", new { label = Localizer["Nav_BookingOnline"].Value })
                <a href="@SiteContent.FacebookUrl" target="_blank" rel="noopener noreferrer" style="display:inline-flex; align-items:center; gap:5px;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="#1877f2"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg> Facebook
                </a>
                <a href="@SiteContent.YouTubeUrl" target="_blank" rel="noopener noreferrer" style="display:inline-flex; align-items:center; gap:5px;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="#ff0000"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg> YouTube Channel
                </a>
                <a href="/sitemap.xml">Sitemap</a>
            </div>
        </div>
        <div class="container footer-bottom">
            <p>&copy; @DateTime.Now.Year @Localizer["Footer_Copyright"]</p>
        </div>
    </footer>

    @await Component.InvokeAsync("SiteInfo", new { template = "FloatActions" })
    @if (ViewData["ShowBackToTop"] as bool? == true)
    {
        <button type="button" class="back-to-top" aria-label="@Localizer["Common_BackToTop"]" title="@Localizer["Common_BackToTop"]">↑</button>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/float-actions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

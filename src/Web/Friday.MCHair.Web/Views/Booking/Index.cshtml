@model BookingViewModel
@using Friday.MCHair.Web.Localization
@{
    bool isEn = CultureHelper.IsEnglish;
}

<section class="page-hero">
    <div class="container">
        <h1>@Localizer["Booking_Title"]</h1>
        <p>@Localizer["Booking_Lead"]</p>
    </div>
</section>

<section class="section">
    <div class="container narrow">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert success">@Model.SuccessMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert error">@Model.ErrorMessage</div>
        }

        @if (string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <form asp-action="Index" method="post" class="booking-form">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>@Localizer["Booking_Name"]</label>
                    <input name="CustomerName" required maxlength="200" />
                </div>
                <div class="form-group">
                    <label>@Localizer["Booking_Phone"]</label>
                    <input name="Phone" required maxlength="30" />
                </div>
                <div class="form-group">
                    <label>@Localizer["Booking_Email"]</label>
                    <input name="Email" type="email" maxlength="200" />
                </div>
                <div class="form-group">
                    <label>@Localizer["Booking_Service"]</label>
                    <select name="HairServiceId" required>
                        @foreach (var s in Model.Form.Services)
                        {
                            <option value="@s.Id" selected="@(Model.PreselectedServiceId == s.Id)">@CatalogTranslations.ServiceName(s.Name, isEn) — @s.PriceFrom.ToString("N0") @(isEn ? "VND" : "vnđ")</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>@Localizer["Booking_Stylist"]</label>
                    <select name="StylistId">
                        <option value="">@Localizer["Booking_StylistDefault"]</option>
                        @foreach (var st in Model.Form.Stylists)
                        {
                            <option value="@st.Id" selected="@(Model.PreselectedStylistId == st.Id)">@st.Name</option>
                        }
                    </select>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>@Localizer["Booking_Date"]</label>
                        <input name="ScheduledDate" type="date" required value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-group">
                        <label>@Localizer["Booking_Time"]</label>
                        <input name="ScheduledTime" type="time" required value="10:00" />
                    </div>
                </div>
                <div class="form-group">
                    <label>@Localizer["Booking_Notes"]</label>
                    <textarea name="Notes" rows="3" maxlength="1000"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">@Localizer["Booking_Submit"]</button>
            </form>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@Localizer["Common_BackHome"]</a>
        }
    </div>
</section>

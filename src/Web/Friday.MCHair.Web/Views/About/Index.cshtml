@{
    var storyParagraphs = SiteContent.SplitParagraphs(LocalizedSiteContent.AboutStoryBody);
    var missionParagraphs = SiteContent.SplitParagraphs(LocalizedSiteContent.MissionBody);
    var visionParagraphs = SiteContent.SplitParagraphs(LocalizedSiteContent.VisionBody);
}

<section class="page-hero about-hero">
    <div class="container page-hero-inner">
        <div class="about-hero-copy">
            <p class="eyebrow">MC Hair Salon</p>
            <h1>@Localizer["About_Title"]</h1>
            <p class="lead">@Localizer["About_Lead"]</p>
        </div>
        <div class="about-hero-logo">
            <img src="@SiteContent.LogoPath" alt="MC Hair Salon" width="280" height="280" />
        </div>
    </div>
</section>

<section class="section">
    <div class="container narrow-content">
        <div class="content-block about-story">
            <h2>@LocalizedSiteContent.AboutStoryTitle</h2>
            @foreach (var paragraph in storyParagraphs)
            {
                <p>@paragraph</p>
            }
            <p class="about-tagline">@LocalizedSiteContent.AboutTagline</p>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container narrow-content">
        <div class="content-block">
            <h2>@LocalizedSiteContent.MissionTitle</h2>
            @foreach (var paragraph in missionParagraphs)
            {
                <p>@paragraph</p>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="container about-split">
        <div class="about-split-image" style="background-image:url('/resources/khong_gian/khong-gian14.jpg')"></div>
        <div class="content-block">
            <h2>@LocalizedSiteContent.VisionTitle</h2>
            @foreach (var paragraph in visionParagraphs)
            {
                <p>@paragraph</p>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head center">
            <h2>@Localizer["About_CoreValuesTitle"]</h2>
            <p>@Localizer["About_CoreValuesLead"]</p>
        </div>
        <div class="values-grid">
            @foreach (var (value, index) in LocalizedSiteContent.CoreValues.Select((v, i) => (v, i + 1)))
            {
                <article class="value-card">
                    <span class="value-number">@index</span>
                    <h3>@value.Title</h3>
                    <p>@value.Description</p>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-cta">
    <div class="container center">
        <h2>@Localizer["About_CtaTitle"]</h2>
        <p>@Localizer["About_CtaLead"]</p>
        @await Component.InvokeAsync("BookingLink", new { cssClass = "btn btn-primary", label = Localizer["Common_BookingNow"].Value })
    </div>
</section>

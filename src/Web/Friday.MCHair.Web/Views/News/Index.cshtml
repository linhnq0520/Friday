@model IReadOnlyList<Friday.Modules.Salon.Application.Models.PromotionDto>

<section class="page-hero">
    <div class="container">
        <h1>@Localizer["News_Title"]</h1>
    </div>
</section>

<section class="section">
    <div class="container promo-list">
        @foreach (var item in Model)
        {
            <article class="promo-item">
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                {
                    <div class="promo-item-image">
                        <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                    </div>
                }
                <div class="promo-item-body">
                    <h2>@item.Title</h2>
                    <p class="muted">@(item.PublishedAt?.ToLocalTime().ToString("dd/MM/yyyy"))</p>
                    @if (!string.IsNullOrWhiteSpace(item.Summary))
                    {
                        <p>@item.Summary</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Content))
                    {
                        <p>@item.Content</p>
                    }
                </div>
            </article>
        }
    </div>
</section>

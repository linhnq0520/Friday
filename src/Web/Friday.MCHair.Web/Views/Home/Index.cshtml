@model HomeIndexViewModel
@using Friday.MCHair.Web.Localization
@{
    var hero = LocalizationExtensions.LocalizeSection(Model.GetSection("hero"));
    var hotGallery = LocalizationExtensions.LocalizeSection(Model.GetSection("gallery_intro"));
    var about = LocalizationExtensions.LocalizeSection(Model.GetSection("about"));
    var servicesIntro = LocalizationExtensions.LocalizeSection(Model.GetSection("services_intro"));
    var partnersIntro = LocalizationExtensions.LocalizeSection(Model.GetSection("partners_intro"));
    var feedbackIntro = LocalizationExtensions.LocalizeSection(Model.GetSection("feedback_intro"));
    var missionPreview = SiteContent.SplitParagraphs(LocalizedSiteContent.MissionBody).FirstOrDefault() ?? string.Empty;
    bool isEn = CultureHelper.IsEnglish;
}

<section class="hero-slider" aria-label="@Localizer["Home_HeroAria"]">
    <div class="hero-slides">
        @for (var i = 0; i < SiteContent.HeroSlides.Length; i++)
        {
            <div class="hero-slide @(i == 0 ? "is-active" : string.Empty)" style="background-image:url('@SiteContent.HeroSlides[i]')"></div>
        }
    </div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <p class="eyebrow">@Model.GetSetting("tagline", "Salon làm tóc chuyên nghiệp")</p>
        <h1>@(hero?.Title ?? "MC Hair Salon")</h1>
        <p class="hero-text">@(hero?.Body ?? (isEn ? "A modern, refined and personalized beauty experience." : "Trải nghiệm làm đẹp hiện đại, tinh tế và cá nhân hoá cho từng khách hàng."))</p>
        <div class="hero-actions">
            @await Component.InvokeAsync("BookingLink", new { cssClass = "btn btn-primary", label = Localizer["Common_BookingNow"].Value })
            <a class="btn btn-outline" asp-controller="Services" asp-action="Index">@Localizer["Home_ViewPriceList"]</a>
        </div>
    </div>
    <div class="hero-dots" role="tablist" aria-label="Chọn ảnh">
        @for (var i = 0; i < SiteContent.HeroSlides.Length; i++)
        {
            <button type="button" class="hero-dot @(i == 0 ? "is-active" : string.Empty)" aria-label="Ảnh @(i + 1)" data-slide="@i"></button>
        }
    </div>
</section>

<section class="section section-hot-gallery" id="collections">
    <div class="container">
        <div class="section-head center">
            <h2>@(hotGallery?.Title ?? Localizer["Home_GalleryFallbackTitle"].Value)</h2>
            <p>@(hotGallery?.Body ?? Localizer["Home_GalleryFallbackBody"].Value)</p>
        </div>
        <div class="collection-grid four">
            @foreach (var collection in Model.Page.GalleryCollections)
            {
                <a class="collection-card" asp-controller="Gallery" asp-action="Category" asp-route-category="@((int)collection.Category)">
                    <div class="collection-card-image">
                        <img src="@collection.CoverImageUrl" alt="@GalleryCategoryLabels.GetLabel(collection.Category)" loading="lazy" />
                        <span class="collection-card-overlay"></span>
                    </div>
                    <div class="collection-card-body">
                        <h3>@GalleryCategoryLabels.GetLabel(collection.Category)</h3>
                        <span class="collection-card-link">@Localizer["Common_SeeMore"]</span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<section class="section" id="about">
    <div class="container about-teaser">
        <div class="about-teaser-copy">
            <h2>@(about?.Title ?? Localizer["Home_AboutFallbackTitle"].Value)</h2>
            <p>@(about?.Body ?? missionPreview)</p>
            <a class="link-more" asp-controller="About" asp-action="Index">@Localizer["Home_AboutMore"]</a>
        </div>
        <div class="about-teaser-image" style="background-image:url('@SiteContent.LogoPath')"></div>
    </div>
</section>

<section class="section section-alt" id="space">
    <div class="container">
        <div class="section-head center">
            <h2>@Localizer["Home_SpaceTitle"]</h2>
            <p>@Localizer["Home_SpaceLead"]</p>
        </div>
        <div class="space-scroll" tabindex="0" aria-label="@Localizer["Home_SpaceAlt"]">
            @foreach (var image in SiteContent.SpaceShowcase)
            {
                <figure class="space-card">
                    <img src="@image" alt="@Localizer["Home_SpaceAlt"]" loading="lazy" />
                </figure>
            }
        </div>
    </div>
</section>

<section class="section" id="services">
    <div class="container">
        <div class="section-head center">
            <h2>@(servicesIntro?.Title ?? Localizer["Home_ServicesFallbackTitle"].Value)</h2>
            <p>@(servicesIntro?.Body)</p>
            <a class="link-more" asp-controller="Services" asp-action="Index">@Localizer["Common_ViewAll"]</a>
        </div>
        <div class="card-grid four">
            @foreach (var service in Model.Page.Services)
            {
                <article class="card service-card">
                    <div class="service-card-image">
                        <img src="@(service.ImageUrl ?? "/resources/khong_gian/khong-gian10.jpg")" alt="@service.Name" loading="lazy" />
                    </div>
                    <h3>@CatalogTranslations.ServiceName(service.Name, isEn)</h3>
                    <p>@CatalogTranslations.ServiceDescription(service.Name, service.Description, isEn)</p>
                    <p class="price">@Localizer["Common_PriceFrom"] <strong>@service.PriceFrom.ToString("N0")</strong> @(isEn ? "VND" : "vnđ")</p>
                    <div class="rating">@service.RatingDisplay ★ @Localizer["Common_Rating"]</div>
                    @await Component.InvokeAsync("BookingLink", new { cssClass = "btn btn-sm", label = Localizer["Common_BookingNow"].Value, serviceId = service.Id })
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-alt" id="promotions">
    <div class="container">
        <div class="section-head center">
            <h2>@Localizer["Home_Promotions"]</h2>
        </div>
        <div class="promo-list">
            @foreach (var promo in Model.Page.Promotions)
            {
                <article class="promo-item">
                    <h3>@promo.Title</h3>
                    <p>@promo.Summary</p>
                    <a asp-controller="News" asp-action="Index">@Localizer["Common_ViewDetails"]</a>
                </article>
            }
        </div>
    </div>
</section>

<section class="section" id="feedback">
    <div class="container">
        <div class="section-head center">
            <h2>@(feedbackIntro?.Title ?? Localizer["Home_FeedbackFallbackTitle"].Value)</h2>
            <p>@(feedbackIntro?.Body ?? Localizer["Home_FeedbackFallbackBody"].Value)</p>
        </div>
        <div class="space-scroll feedback-scroll" tabindex="0" aria-label="Feedback khách hàng">
            @foreach (var item in Model.Page.FeedbackShowcase)
            {
                <figure class="space-card">
                    <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                </figure>
            }
        </div>
    </div>
</section>

<section class="section section-alt" id="before-after">
    <div class="container">
        <div class="section-head center">
            <h2>Before &amp; After</h2>
            <p>@Localizer["Home_BeforeAfterLead"]</p>
        </div>
        <div class="space-scroll before-after-scroll" tabindex="0" aria-label="Ảnh Before và After">
            @foreach (var item in Model.Page.BeforeAfterShowcase)
            {
                <figure class="space-card">
                    <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                </figure>
            }
        </div>
    </div>
</section>

<section class="section" id="stylists">
    <div class="container">
        <div class="section-head center">
            <h2>@Localizer["Home_StylistsTitle"]</h2>
            <p>@Localizer["Home_StylistsLead"]</p>
        </div>
        <div class="card-grid three">
            @foreach (var stylist in Model.Page.Stylists)
            {
                <article class="card stylist-card">
                    <div class="stylist-card-image">
                        <img src="@(stylist.ImageUrl ?? "/resources/khong_gian/khong-gian9.jpg")" alt="@stylist.Name" loading="lazy" />
                    </div>
                    <h3>@stylist.Name</h3>
                    @await Component.InvokeAsync("BookingLink", new { cssClass = "btn btn-sm", label = Localizer["Common_BookingNow"].Value, stylistId = stylist.Id })
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-alt" id="partners">
    <div class="container">
        <div class="section-head center">
            <h2>@(partnersIntro?.Title ?? Localizer["Home_PartnersFallbackTitle"].Value)</h2>
            <p>@(partnersIntro?.Body ?? Localizer["Home_PartnersFallbackBody"].Value)</p>
        </div>
        <div class="partners-grid">
            @foreach (var partner in Model.Page.Partners)
            {
                <article class="partner-card">
                    <div class="partner-logo">
                        @if (!string.IsNullOrWhiteSpace(partner.LogoUrl))
                        {
                            <img src="@partner.LogoUrl" alt="@partner.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="partner-logo-fallback">@(partner.Name.Length > 0 ? partner.Name[0].ToString() : "?")</span>
                        }
                    </div>
                    <h3>@partner.Name</h3>
                    @if (!string.IsNullOrWhiteSpace(partner.Description))
                    {
                        <p>@CatalogTranslations.PartnerDescription(partner.Name, partner.Description, isEn)</p>
                    }
                </article>
            }
        </div>
    </div>
</section>

@section Head {
    <script>
        document.getElementById('site-hotline').textContent = '@Model.GetSetting("hotline", SiteContent.DefaultHotline)';
    </script>
}

@section Scripts {
    <script src="~/js/hero-slider.js" asp-append-version="true"></script>
}

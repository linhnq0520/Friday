@model HomeIndexViewModel
@using Friday.MCHair.Web.Models
@{
    var hero = Model.GetSection("hero");
    var hotGallery = Model.GetSection("gallery_intro");
    var about = Model.GetSection("about");
    var servicesIntro = Model.GetSection("services_intro");
    var partnersIntro = Model.GetSection("partners_intro");
    var feedbackIntro = Model.GetSection("feedback_intro");
    var missionPreview = SiteContent.MissionBody
        .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .FirstOrDefault() ?? string.Empty;
}

<section class="hero-slider" aria-label="Không gian MC Hair">
    <div class="hero-slides">
        @for (var i = 0; i < SiteContent.HeroSlides.Length; i++)
        {
            <div class="hero-slide @(i == 0 ? "is-active" : string.Empty)" style="background-image:url('@SiteContent.HeroSlides[i]')"></div>
        }
    </div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <p class="eyebrow">@Model.GetSetting("tagline", "Salon làm tóc chuyên nghiệp")</p>
        <h1>@(hero?.Title ?? "MC Hair Salon")</h1>
        <p class="hero-text">@(hero?.Body ?? "Trải nghiệm làm đẹp hiện đại, tinh tế và cá nhân hoá cho từng khách hàng.")</p>
        <div class="hero-actions">
            <a class="btn btn-primary" asp-controller="Booking" asp-action="Index">Đặt lịch ngay</a>
            <a class="btn btn-outline" asp-controller="Services" asp-action="Index">Xem bảng giá</a>
        </div>
    </div>
    <div class="hero-dots" role="tablist" aria-label="Chọn ảnh">
        @for (var i = 0; i < SiteContent.HeroSlides.Length; i++)
        {
            <button type="button" class="hero-dot @(i == 0 ? "is-active" : string.Empty)" aria-label="Ảnh @(i + 1)" data-slide="@i"></button>
        }
    </div>
</section>

<section class="section section-hot-gallery" id="collections">
    <div class="container">
        <div class="section-head center">
            <h2>@(hotGallery?.Title ?? "Mẫu tóc hot")</h2>
            <p>@(hotGallery?.Body ?? "Chào mừng Quý khách đến với MC Hair Salon. Dưới đây là bộ sưu tập những mẫu tóc đẹp giúp nâng tầm vẻ đẹp của bạn.")</p>
        </div>
        <div class="collection-grid four">
            @foreach (var collection in Model.Page.GalleryCollections)
            {
                <a class="collection-card" asp-controller="Gallery" asp-action="Category" asp-route-category="@((int)collection.Category)">
                    <div class="collection-card-image">
                        <img src="@collection.CoverImageUrl" alt="@GalleryCategoryLabels.GetLabel(collection.Category)" loading="lazy" />
                        <span class="collection-card-overlay"></span>
                    </div>
                    <div class="collection-card-body">
                        <h3>@GalleryCategoryLabels.GetLabel(collection.Category)</h3>
                        <span class="collection-card-link">Xem thêm →</span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<section class="section" id="about">
    <div class="container about-teaser">
        <div class="about-teaser-copy">
            <h2>@(about?.Title ?? "Về MC Hair")</h2>
            <p>@(about?.Body ?? missionPreview)</p>
            <a class="link-more" asp-controller="About" asp-action="Index">Tìm hiểu sứ mệnh &amp; tầm nhìn →</a>
        </div>
        <div class="about-teaser-image" style="background-image:url('@SiteContent.LogoPath')"></div>
    </div>
</section>

<section class="section section-alt" id="space">
    <div class="container">
        <div class="section-head center">
            <h2>Không gian MC Hair</h2>
            <p>Thiết kế hiện đại, ấm cúng – nơi bạn tìm thấy sự tự tin và phong cách riêng.</p>
        </div>
        <div class="space-scroll" tabindex="0" aria-label="Ảnh không gian salon">
            @foreach (var image in SiteContent.SpaceShowcase)
            {
                <figure class="space-card">
                    <img src="@image" alt="Không gian MC Hair Salon" loading="lazy" />
                </figure>
            }
        </div>
    </div>
</section>

<section class="section" id="services">
    <div class="container">
        <div class="section-head center">
            <h2>@(servicesIntro?.Title ?? "Dịch vụ tóc")</h2>
            <p>@(servicesIntro?.Body)</p>
            <a class="link-more" asp-controller="Services" asp-action="Index">Xem tất cả</a>
        </div>
        <div class="card-grid four">
            @foreach (var service in Model.Page.Services)
            {
                <article class="card service-card">
                    <div class="service-card-image">
                        <img src="@(service.ImageUrl ?? "/resources/khong_gian/khong-gian10.jpg")" alt="@service.Name" loading="lazy" />
                    </div>
                    <h3>@service.Name</h3>
                    <p>@service.Description</p>
                    <p class="price">Giá từ: <strong>@service.PriceFrom.ToString("N0")</strong> vnđ</p>
                    <div class="rating">@service.RatingDisplay ★ đánh giá</div>
                    <a class="btn btn-sm" asp-controller="Booking" asp-action="Index" asp-route-serviceId="@service.Id">Đặt lịch ngay</a>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-alt" id="promotions">
    <div class="container">
        <div class="section-head center">
            <h2>Chương trình khuyến mãi</h2>
        </div>
        <div class="promo-list">
            @foreach (var promo in Model.Page.Promotions)
            {
                <article class="promo-item">
                    <h3>@promo.Title</h3>
                    <p>@promo.Summary</p>
                    <a asp-controller="News" asp-action="Index">Xem chi tiết</a>
                </article>
            }
        </div>
    </div>
</section>

<section class="section" id="feedback">
    <div class="container">
        <div class="section-head center">
            <h2>@(feedbackIntro?.Title ?? "Feedback khách hàng")</h2>
            <p>@(feedbackIntro?.Body ?? "Dưới đây là những chia sẻ và cảm nhận của khách hàng khi sử dụng dịch vụ tại MC Hair Salon.")</p>
        </div>
        <div class="space-scroll feedback-scroll" tabindex="0" aria-label="Feedback khách hàng">
            @foreach (var item in Model.Page.FeedbackShowcase)
            {
                <figure class="space-card">
                    <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                </figure>
            }
        </div>
    </div>
</section>

<section class="section section-alt" id="before-after">
    <div class="container">
        <div class="section-head center">
            <h2>Before &amp; After</h2>
            <p>Cùng nhìn lại hành trình thay đổi diện mạo của khách hàng tại MC Hair Salon.</p>
        </div>
        <div class="space-scroll before-after-scroll" tabindex="0" aria-label="Ảnh Before và After">
            @foreach (var item in Model.Page.BeforeAfterShowcase)
            {
                <figure class="space-card">
                    <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                </figure>
            }
        </div>
    </div>
</section>

<section class="section" id="stylists">
    <div class="container">
        <div class="section-head center">
            <h2>MC Hair Stylist</h2>
            <p>Đội ngũ nghệ sĩ tóc giàu kinh nghiệm, sáng tạo và tận tâm.</p>
        </div>
        <div class="card-grid three">
            @foreach (var stylist in Model.Page.Stylists)
            {
                <article class="card stylist-card">
                    <div class="stylist-card-image">
                        <img src="@(stylist.ImageUrl ?? "/resources/khong_gian/khong-gian9.jpg")" alt="@stylist.Name" loading="lazy" />
                    </div>
                    <h3>@stylist.Name</h3>
                    <a class="btn btn-sm" asp-controller="Booking" asp-action="Index" asp-route-stylistId="@stylist.Id">Đặt lịch ngay</a>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-alt" id="partners">
    <div class="container">
        <div class="section-head center">
            <h2>@(partnersIntro?.Title ?? "Đối tác")</h2>
            <p>@(partnersIntro?.Body ?? "Kết hợp với các thương hiệu chăm sóc tóc uy tín tại MC Hair Salon.")</p>
        </div>
        <div class="partners-grid">
            @foreach (var partner in Model.Page.Partners)
            {
                <article class="partner-card">
                    <div class="partner-logo">
                        @if (!string.IsNullOrWhiteSpace(partner.LogoUrl))
                        {
                            <img src="@partner.LogoUrl" alt="@partner.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="partner-logo-fallback">@(partner.Name.Length > 0 ? partner.Name[0].ToString() : "?")</span>
                        }
                    </div>
                    <h3>@partner.Name</h3>
                    @if (!string.IsNullOrWhiteSpace(partner.Description))
                    {
                        <p>@partner.Description</p>
                    }
                </article>
            }
        </div>
    </div>
</section>

@section Head {
    <script>
        document.getElementById('site-hotline').textContent = '@Model.GetSetting("hotline", SiteContent.DefaultHotline)';
    </script>
}

@section Scripts {
    <script src="~/js/hero-slider.js" asp-append-version="true"></script>
}

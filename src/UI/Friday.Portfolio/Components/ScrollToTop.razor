@inject IJSRuntime JS
@inject LanguageService Lang

<button id="btn-scroll-to-top"
        type="button"
        class="scroll-to-top no-print"
        @onclick="ScrollToTopAsync"
        aria-label="@Lang.Text("Quay về đầu trang", "Back to top")"
        title="@Lang.Text("Quay về đầu trang", "Back to top")">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 15l-6-6-6 6" />
    </svg>
</button>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initScrollToTop", "btn-scroll-to-top");
        }
    }

    private async Task ScrollToTopAsync()
    {
        await JS.InvokeVoidAsync("scrollToTop");
    }
}

<section id="contact" class="section contact">
    <div class="section-inner contact-inner">
        <header class="section-head">
            <p class="section-label">Contact</p>
            <h2>Let's talk systems</h2>
            <p class="section-lead">Open to Technical Lead opportunities and international onsite collaboration.</p>
        </header>

        <ul class="contact-list">
            <li>
                <span>Email</span>
                <a href="mailto:@ProfileData.Email">@ProfileData.Email</a>
            </li>
            <li>
                <span>Phone</span>
                <a href="tel:@ProfileData.Phone.Replace(" ", "")">@ProfileData.Phone</a>
            </li>
            <li>
                <span>LinkedIn</span>
                <a href="@ProfileData.LinkedIn" target="_blank" rel="noopener noreferrer">@ProfileData.LinkedInDisplay</a>
            </li>
        </ul>
    </div>
</section>

@using Friday.Portfolio.Models
@using Friday.Portfolio.Services
@inject LanguageService Lang

<section id="education" class="section education">
    <div class="section-inner">
        <header class="section-head">
            <p class="section-label">@Lang.Text("Học vấn", "Education")</p>
            <h2>@Lang.Text("Học vấn & Chứng chỉ", "Academic Background & Certifications")</h2>
        </header>

        <ul class="edu-list">
            @if (Model?.Education != null)
            {
                @foreach (var item in Model.Education)
                {
                    <li>
                        <h3>@item.Institution</h3>
                        <p>@item.Degree</p>
                        <time>@item.Period</time>
                    </li>
                }
            }
        </ul>
    </div>
</section>

@code {
    [Parameter] public ProfileModel? Model { get; set; }

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }
}

@using Friday.Portfolio.Models
@using Friday.Portfolio.Services
@inject LanguageService Lang

<section id="projects" class="section projects">
    <div class="section-inner">
        <header class="section-head">
            <p class="section-label">@Lang.Text("Dự án & Thư viện", "Projects & Libraries")</p>
            <h2>@Lang.Text("Mã nguồn mở & Packages", "Open Source & NuGet Packages")</h2>
        </header>

        <div class="project-list">
            @if (Model?.Projects != null)
            {
                @foreach (var project in Model.Projects)
                {
                    <article class="project-row">
                        <div>
                            <h3>@project.Title</h3>
                            <p>@project.Description</p>
                            <p class="tech-line">@string.Join(" · ", project.TechStack)</p>
                        </div>
                        <a class="project-link" href="@project.Url" target="_blank" rel="noopener noreferrer">
                            @project.UrlLabel
                            <span aria-hidden="true">↗</span>
                        </a>
                    </article>
                }
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public ProfileModel? Model { get; set; }

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }
}

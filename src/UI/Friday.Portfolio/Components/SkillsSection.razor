<section id="skills" class="section skills">
    <div class="section-inner">
        <header class="section-head">
            <p class="section-label">Skills</p>
            <h2>Toolbox</h2>
        </header>

        <div class="skill-groups">
            <div class="skill-group">
                <h3>Languages</h3>
                <p>@string.Join(" · ", ProfileData.Languages)</p>
            </div>
            <div class="skill-group">
                <h3>Frameworks</h3>
                <p>@string.Join(" · ", ProfileData.Frameworks)</p>
            </div>
            <div class="skill-group">
                <h3>Databases</h3>
                <p>@string.Join(" · ", ProfileData.Databases)</p>
            </div>
            <div class="skill-group">
                <h3>Tools &amp; platforms</h3>
                <p>@string.Join(" · ", ProfileData.Tools)</p>
            </div>
        </div>
    </div>
</section>

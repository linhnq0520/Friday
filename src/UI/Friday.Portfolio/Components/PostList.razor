<div class="post-list">
    @foreach (var post in Posts)
    {
        <article class="post-row">
            <div>
                <p class="post-meta">
                    <time>@post.Published.ToString("MMM d, yyyy")</time>
                    <span>·</span>
                    <span>@post.MinutesToRead min</span>
                    @if (post.Featured)
                    {
                        <span class="featured-flag">Featured</span>
                    }
                </p>
                <h3><a href="@($"/blog/{post.Slug}")">@post.Title</a></h3>
                <p>@post.Summary</p>
                <div class="tag-row compact">
                    @foreach (var tag in post.Tags)
                    {
                        <span class="tag">@tag</span>
                    }
                </div>
            </div>
            <a class="text-link" href="@($"/blog/{post.Slug}")">Read article →</a>
        </article>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IEnumerable<BlogArticle> Posts { get; set; } = [];
}

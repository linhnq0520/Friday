@page "/blog"

<PageTitle>Blog — @ProfileData.FullName</PageTitle>

<section class="section page-hero">
    <div class="section-inner">
        <p class="section-label">Blog</p>
        <h1>Articles &amp; field notes</h1>
        <p class="section-lead">
            Deep-dives on .NET, distributed systems, and Azure — focused on what I ship in fintech and core banking.
            Sample posts below are learning examples; more articles will land as I publish.
        </p>
        <div class="tag-row">
            @foreach (var topic in ProfileData.Topics)
            {
                <span class="tag">@topic</span>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="section-inner">
        <PostList Posts="SiteContent.Posts.OrderByDescending(p => p.Published)" />
    </div>
</section>

@page "/courses/{Slug}"

<PageTitle>@(course?.Title ?? "Course") — @ProfileData.FullName</PageTitle>

@if (course is null)
{
    <section class="section">
        <div class="section-inner">
            <h1>Course not found</h1>
            <a class="btn btn-primary" href="/courses">Back to courses</a>
        </div>
    </section>
}
else
{
    <section class="section page-hero">
        <div class="section-inner">
            <p class="section-label">@course.Level · @course.LessonCount lessons · @(course.IsFree ? "Free" : "Paid")</p>
            <h1>@course.Title</h1>
            <p class="section-lead">@course.Summary</p>
            <p class="status-pill">@course.Status</p>
        </div>
    </section>

    <section class="section">
        <div class="section-inner split">
            <div>
                <h2>What you will walk away with</h2>
                <ul class="outcome-list">
                    @foreach (var outcome in course.Outcomes)
                    {
                        <li>@outcome</li>
                    }
                </ul>
            </div>
            <div>
                <h2>Topics</h2>
                <div class="tag-row">
                    @foreach (var topic in course.Topics)
                    {
                        <span class="tag">@topic</span>
                    }
                </div>
                <p class="muted-block">
                    This course is an example roadmap still <strong>In progress</strong>.
                    Outcomes and topics are placeholders until full lessons are published.
                </p>
                <a class="btn btn-primary" href="@mailtoLink">Ask about this course</a>
            </div>
        </div>
        <div class="section-inner">
            <p class="article-back"><a class="text-link" href="/courses">← All courses</a></p>
        </div>
    </section>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private Course? course;
    private string mailtoLink = "mailto:" + ProfileData.Email;

    protected override void OnParametersSet()
    {
        course = SiteContent.FindCourse(Slug);
        if (course is not null)
        {
            mailtoLink =
                $"mailto:{ProfileData.Email}?subject={Uri.EscapeDataString("Course: " + course.Title)}";
        }
    }
}

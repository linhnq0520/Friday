@page "/about"
@page "/cv"
@using Friday.Portfolio.Components
@using Friday.Portfolio.Models
@using Friday.Portfolio.Services
@inject ProfileService ProfileService
@inject LanguageService Lang
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@Lang.Text("Hồ sơ & CV", "Profile & CV") — @(profile?.FullName ?? "Nguyen Quoc Linh")</PageTitle>

@if (profile == null)
{
    <section class="section page-hero">
        <div class="section-inner">
            <p>@Lang.Text("Đang tải dữ liệu hồ sơ...", "Loading profile data...")</p>
        </div>
    </section>
}
else
{
    <section class="section page-hero">
        <div class="section-inner">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <p class="section-label">@Lang.Text("Hồ sơ cá nhân / Online CV", "Personal Profile / Online CV")</p>
                    <h1>@profile.FullName <span class="thin">(@profile.Nickname)</span></h1>
                </div>
                <div class="no-print" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                    <button class="btn btn-primary" @onclick="DownloadPdfA4" disabled="@isExporting">
                        <span>📥</span>
                        <span>@Lang.Text("Tải CV chuẩn A4 (PDF)", "Download A4 CV (PDF)")</span>
                    </button>
                    <a class="btn btn-ghost" href="/admin">
                        <span>✏️</span>
                        <span>@Lang.Text("Chỉnh sửa CV", "Edit CV")</span>
                    </a>
                </div>
            </div>
            <p class="section-lead">@profile.Summary</p>
            <p class="section-lead muted">@profile.Objective</p>
        </div>
    </section>

    <!-- Overlay xoay màu vàng tối giản khi đang xuất file PDF -->
    @if (isExporting)
    {
        <div class="cv-export-overlay" aria-live="polite">
            <div class="cv-gold-spinner-ring"></div>
        </div>
    }

    <!-- Giao diện Web hiển thị bình thường -->
    <div id="cv-web-view">
        <AboutSection Model="profile" />
        <ExperienceSection Model="profile" />
        <ProjectsSection Model="profile" />
        <SkillsSection Model="profile" />
        <EducationSection Model="profile" />
        <ContactSection Model="profile" />
    </div>

    <!-- Mẫu CV Executive Printable Khổ A4 Chuẩn Tuyển Dụng (Chỉ hiển thị khi In/Xuất PDF) -->
    <div class="print-resume-document" style="display: none; width: 642px; background: #ffffff; color: #111111; font-family: Arial, Helvetica, sans-serif; font-size: 9.4pt; line-height: 1.3; padding: 0; margin: 0; box-sizing: border-box;">
        <!-- Header -->
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 4px; border: none;">
            <tr>
                <td style="text-align: center; vertical-align: middle; border: none; padding: 0 10px 0 0;">
                    <h1 style="font-family: Georgia, 'Times New Roman', serif; font-size: 21pt; font-weight: 500; color: #111111; margin: 0 0 2px 0; letter-spacing: 0.2px;">@profile.FullName <span style="font-weight: 400; font-size: 16.5pt; color: #222222;">(@profile.Nickname)</span></h1>
                    <p style="font-family: Georgia, 'Times New Roman', serif; font-size: 14pt; font-weight: 400; color: #111111; margin: 0 0 4px 0;">@profile.Title</p>

                    <p style="font-family: Arial, sans-serif; font-size: 9.4pt; color: #222222; margin: 1.5px 0;">
                        <span>Phone: <strong>@profile.Phone</strong></span>
                        <span style="color: #555555; margin: 0 4px;">/</span>
                        <span>Email: <strong>@profile.Email</strong></span>
                        @if (!string.IsNullOrWhiteSpace(profile.DateOfBirth))
                        {
                            <span style="color: #555555; margin: 0 4px;">/</span>
                            <span>DOB: <strong>@profile.DateOfBirth</strong></span>
                        }
                    </p>

                    <p style="font-family: Arial, sans-serif; font-size: 9.4pt; color: #222222; margin: 1.5px 0;">
                        <span>LinkedIn: <span style="text-decoration: underline;">@profile.LinkedInDisplay</span></span>
                        <span style="color: #555555; margin: 0 4px;">/</span>
                        <span>Website: <span style="text-decoration: underline;">@GetWebsiteDisplay()</span></span>
                    </p>
                </td>
                <td style="width: 100px; text-align: right; vertical-align: middle; border: none; padding: 0;">
                    <img src="img/linh.jpg" width="95" height="110" style="width: 95px; height: 110px; object-fit: cover; border-radius: 12px; border: 1px solid #cccccc; display: block; margin-left: auto;" alt="@profile.FullName (@profile.Nickname)" />
                </td>
            </tr>
        </table>

        <!-- SUMMARY SECTION -->
        <div class="print-sec" style="margin-bottom: 9px;">
            <div class="print-sec-head" style="border-top: 1.5px solid #222222; padding-top: 6px; margin-top: 10px; margin-bottom: 4px; text-align: center;">
                <h2 style="font-family: Georgia, 'Times New Roman', serif; font-size: 12.5pt; font-weight: 500; color: #111111; text-transform: uppercase; margin: 0; letter-spacing: 0.5px;">SUMMARY</h2>
            </div>
            <p style="font-size: 9.6pt; color: #222222; margin: 0 0 2px 0; text-align: justify; line-height: 1.32;">@profile.Summary</p>
            <p style="font-size: 9.6pt; color: #222222; margin: 0; text-align: justify; line-height: 1.32;">@profile.Objective</p>
        </div>

        <!-- TECHNICAL SKILLS SECTION -->
        <div class="print-sec" style="margin-bottom: 9px;">
            <div class="print-sec-head" style="border-top: 1.5px solid #222222; padding-top: 6px; margin-top: 10px; margin-bottom: 4px; text-align: center;">
                <h2 style="font-family: Georgia, 'Times New Roman', serif; font-size: 12.5pt; font-weight: 500; color: #111111; text-transform: uppercase; margin: 0; letter-spacing: 0.5px;">TECHNICAL SKILLS</h2>
            </div>
            <ul style="margin: 0; padding: 0; list-style: none;">
                <li style="font-size: 9.6pt; color: #222222; margin-bottom: 2px; line-height: 1.32;"><strong>Programming Languages:</strong> @string.Join(", ", profile.Languages)</li>
                <li style="font-size: 9.6pt; color: #222222; margin-bottom: 2px; line-height: 1.32;"><strong>Frameworks/Platforms:</strong> @string.Join(", ", profile.Frameworks)</li>
                <li style="font-size: 9.6pt; color: #222222; margin-bottom: 2px; line-height: 1.32;"><strong>Database Management Systems:</strong> @string.Join(", ", profile.Databases)</li>
                <li style="font-size: 9.6pt; color: #222222; margin-bottom: 2px; line-height: 1.32;"><strong>Tools and Technologies:</strong> @string.Join(", ", profile.Tools)</li>
            </ul>
        </div>

        <!-- PROFESSIONAL EXPERIENCE SECTION -->
        <div class="print-sec" style="margin-bottom: 9px;">
            <div class="print-sec-head" style="border-top: 1.5px solid #222222; padding-top: 6px; margin-top: 10px; margin-bottom: 4px; text-align: center;">
                <h2 style="font-family: Georgia, 'Times New Roman', serif; font-size: 12.5pt; font-weight: 500; color: #111111; text-transform: uppercase; margin: 0; letter-spacing: 0.5px;">PROFESSIONAL EXPERIENCE</h2>
            </div>
            @foreach (var exp in profile.Experiences)
            {
                <div class="print-job" style="margin-bottom: 5px; page-break-inside: avoid; break-inside: avoid;">
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 1px; border: none;">
                        <tr>
                            <td style="text-align: left; vertical-align: baseline; font-size: 10.4pt; color: #111111; border: none; padding: 0;">
                                <strong>@exp.Company</strong> – <em>@exp.Role</em>
                            </td>
                            <td style="text-align: right; vertical-align: baseline; font-size: 9.2pt; font-style: italic; color: #444444; white-space: nowrap; border: none; padding: 0;">
                                @exp.Period
                            </td>
                        </tr>
                    </table>
                    @if (!string.IsNullOrWhiteSpace(exp.Location))
                    {
                        <p style="font-size: 8.8pt; color: #555555; margin: 0 0 2px 0; font-style: italic;">@exp.Location</p>
                    }
                    <ul style="margin: 2px 0 3px 15px; padding: 0;">
                        @foreach (var bullet in exp.Bullets)
                        {
                            <li style="font-size: 9.5pt; color: #222222; margin-bottom: 1px; line-height: 1.3;">@bullet</li>
                        }
                    </ul>
                    @if (exp.Tags.Count > 0)
                    {
                        <p style="font-size: 9.2pt; color: #222222; margin: 2px 0 1px 0;"><strong>Technologies:</strong> @string.Join(", ", exp.Tags)</p>
                    }
                </div>
            }
        </div>

        <!-- PERSONAL PROJECTS SECTION -->
        @if (profile.Projects.Count > 0)
        {
            <div class="print-sec print-sec-projects" style="margin-bottom: 9px;">
                <div class="print-sec-head" style="border-top: 1.5px solid #222222; padding-top: 6px; margin-top: 10px; margin-bottom: 4px; text-align: center;">
                    <h2 style="font-family: Georgia, 'Times New Roman', serif; font-size: 12.5pt; font-weight: 500; color: #111111; text-transform: uppercase; margin: 0; letter-spacing: 0.5px;">PERSONAL PROJECTS</h2>
                </div>
                @foreach (var proj in profile.Projects)
                {
                    <div class="print-project" style="margin-bottom: 5px; page-break-inside: avoid; break-inside: avoid;">
                        <p style="font-size: 10.4pt; color: #111111; margin: 0 0 2px 0;">Project: <strong>@proj.Title</strong></p>
                        <p style="font-size: 9.6pt; color: #222222; margin: 0 0 2px 0; text-align: justify; line-height: 1.32;">@proj.Description</p>
                        <p style="font-size: 9.2pt; color: #222222; margin: 2px 0 1px 0;"><strong>Technologies:</strong> @string.Join(", ", proj.TechStack)</p>
                        @if (!string.IsNullOrWhiteSpace(proj.Url))
                        {
                            <p style="font-size: 9pt; color: #333333; margin-top: 1.5px;"><strong>@proj.UrlLabel:</strong> <span style="text-decoration: underline;">@proj.Url</span></p>
                        }
                    </div>
                }
            </div>
        }

        <!-- EDUCATION SECTION -->
        <div class="print-sec print-sec-edu" style="margin-bottom: 6px;">
            <div class="print-sec-head" style="border-top: 1.5px solid #222222; padding-top: 6px; margin-top: 10px; margin-bottom: 4px; text-align: center;">
                <h2 style="font-family: Georgia, 'Times New Roman', serif; font-size: 12.5pt; font-weight: 500; color: #111111; text-transform: uppercase; margin: 0; letter-spacing: 0.5px;">EDUCATION</h2>
            </div>
            @foreach (var edu in profile.Education)
            {
                <div class="print-edu" style="margin-bottom: 5px; page-break-inside: avoid; break-inside: avoid;">
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 1px; border: none;">
                        <tr>
                            <td style="text-align: left; vertical-align: baseline; font-size: 10.4pt; color: #111111; border: none; padding: 0;">
                                <strong>@edu.Institution</strong>
                            </td>
                            <td style="text-align: right; vertical-align: baseline; font-size: 9.2pt; color: #444444; white-space: nowrap; border: none; padding: 0;">
                                @edu.Period
                            </td>
                        </tr>
                    </table>
                    <p style="font-size: 9.6pt; color: #222222; margin: 0 0 2px 0;">@edu.Degree</p>
                </div>
            }
        </div>
    </div>
}

@code {
    private ProfileModel? profile;
    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        profile = await ProfileService.GetProfileAsync();
    }

    private async Task DownloadPdfA4()
    {
        if (isExporting) return;
        isExporting = true;
        StateHasChanged();
        await Task.Delay(100); // Cho phép Blazor render ngay Overlay xoay màu vàng trước khi JS xử lý
        try
        {
            var fileName = profile != null
                ? $"{profile.FullName.Replace(" ", "_")}_CV.pdf"
                : "Nguyen_Quoc_Linh_CV.pdf";
            await JS.InvokeVoidAsync("exportCvToPdf", fileName);
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private string GetWebsiteDisplay()
    {
        if (!string.IsNullOrWhiteSpace(profile?.WebsiteUrl))
        {
            return profile.WebsiteUrl.Replace("https://", "").Replace("http://", "").TrimEnd('/');
        }
        try
        {
            var uri = new Uri(Navigation.BaseUri);
            return uri.Host + (uri.IsDefaultPort ? "" : $":{uri.Port}");
        }
        catch
        {
            return "quoclinh.dev";
        }
    }
}

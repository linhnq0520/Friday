@page "/blog/{Slug}"
@inject MarkdownContentService Markdown

<PageTitle>@(post?.Title ?? "Post") — @ProfileData.FullName</PageTitle>

@if (post is null)
{
    <section class="section">
        <div class="section-inner">
            <h1>Post not found</h1>
            <a class="btn btn-primary" href="/blog">Back to blog</a>
        </div>
    </section>
}
else
{
    <article class="section article">
        <div class="section-inner article-inner">
            <p class="section-label">@string.Join(" · ", post.Tags)</p>
            <h1>@post.Title</h1>
            <p class="article-meta">
                <time>@post.Published.ToString("MMM d, yyyy")</time>
                <span>·</span>
                <span>@post.MinutesToRead min read</span>
            </p>
            <p class="section-lead">@post.Summary</p>
            <div class="markdown-body">
                @html
            </div>
            <p class="article-back">
                <a class="text-link" href="/blog">← All articles</a>
            </p>
        </div>
    </article>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private BlogArticle? post;
    private MarkupString html;

    protected override async Task OnParametersSetAsync()
    {
        post = SiteContent.FindPost(Slug);
        if (post is not null)
        {
            html = await Markdown.GetHtmlAsync(post.MarkdownPath);
        }
    }
}

            model.Projects.Insert(index - 1, item);
        }
    }

    private void MoveProjectDown(int index)
    {
        if (model != null && index >= 0 && index < model.Projects.Count - 1)
        {
            var item = model.Projects[index];
            model.Projects.RemoveAt(index);
            model.Projects.Insert(index + 1, item);
        }
    }

    // Education helpers
    private void AddEducation()
    {
        if (model == null) return;
        model.Education.Add(new EducationModel
        {
            Institution = "Cơ sở đào tạo / University",
            Degree = "Chuyên ngành / Degree",
            Period = "2017 - 2021"
        });
    }

    private void RemoveEducation(int index)
    {
        if (model != null && index >= 0 && index < model.Education.Count)
        {
            model.Education.RemoveAt(index);
        }
    }

    private void MoveEducationUp(int index)
    {
        if (model != null && index > 0 && index < model.Education.Count)
        {
            var item = model.Education[index];
            model.Education.RemoveAt(index);
            model.Education.Insert(index - 1, item);
        }
    }

    private void MoveEducationDown(int index)
    {
        if (model != null && index >= 0 && index < model.Education.Count - 1)
        {
            var item = model.Education[index];
            model.Education.RemoveAt(index);
            model.Education.Insert(index + 1, item);
        }
    }

@page "/admin"
@page "/editor"
@implements IDisposable
@using Friday.Portfolio.Models
@using Friday.Portfolio.Services
@inject ProfileService ProfileService
@inject AdminAuthService AuthService
@inject LanguageService Lang
@inject IJSRuntime JS

<PageTitle>@Lang.Text("Quản Trị & Chỉnh Sửa Profile — CV Editor", "Admin & Profile Editor — CV Editor")</PageTitle>

<section class="section page-hero">
    <div class="section-inner">
        <p class="section-label">@Lang.Text("⚡ Quản trị / Trình biên tập CMS", "⚡ Admin / CMS Editor")</p>
        <h1>@Lang.Text("Chỉnh Sửa Thông Tin Profile & CV Online", "Edit Online Profile & CV Information")</h1>
        <p class="section-lead">@Lang.Text("Chỉnh sửa trực tiếp thông tin cá nhân, kinh nghiệm làm việc, kỹ năng và xuất file JSON mới.", "Directly edit personal information, work experience, skills and export a new JSON file.")</p>
    </div>
</section>

@if (!isAuthenticated)
{
    <section class="section">
        <div class="section-inner" style="max-width: 480px; margin: 0 auto; background: var(--card-bg, #1a1e24); padding: 2rem; border-radius: 12px; border: 1px solid var(--border-color, #2a2f38);">
            <h2 style="margin-top: 0;">@Lang.Text("🔒 Xác Thực Quản Trị", "🔒 Admin Authentication")</h2>
            <p>@Lang.Text("Vui lòng nhập mật khẩu quản trị để chỉnh sửa thông tin Profile & CV:", "Please enter the admin password to edit Profile & CV information:")</p>

            <form @onsubmit="HandleLogin">
                <div style="margin-bottom: 1.5rem;">
                    <label style="display: block; margin-bottom: 6px;">@Lang.Text("Mật khẩu Admin:", "Admin Password:")</label>
                    <input type="password" @bind="inputPassword" placeholder="@Lang.Text("Nhập mật khẩu Admin...", "Enter Admin password...")" style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #3a3f48; background: #0f1217; color: #fff;" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p style="color: #ff4d4f; font-size: 0.9rem; margin-bottom: 1rem;">@errorMessage</p>
                }

                <div style="display: flex; gap: 1rem;">
                    <button type="submit" class="btn btn-primary" style="width: 100%;">@Lang.Text("Đăng Nhập Quản Trị", "Admin Login")</button>
                </div>
            </form>
        </div>
    </section>
}
else if (model == null)
{
    <section class="section">
        <div class="section-inner">
            <p>@Lang.Text("Đang tải dữ liệu...", "Loading data...")</p>
        </div>
    </section>
}
else
{
    <section class="section">
        <div class="section-inner">
            <div style="background: var(--card-bg, #1a1e24); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; border: 1px solid var(--border-color, #2a2f38);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                    <h3 style="margin: 0;">@Lang.Text("📤 Xuất dữ liệu JSON", "📤 Export JSON Data")</h3>
                    <button class="btn btn-ghost" @onclick="HandleLogout" style="font-size: 0.85rem;">@Lang.Text("🔒 Đăng xuất Quản trị", "🔒 Admin Logout")</button>
                </div>
                <p style="margin-top: 0.5rem;">
                    @if (Lang.IsVietnamese)
                    {
                        <span>Sau khi chỉnh sửa xong, bấm nút <strong>Tải về file profile.json</strong> để ghi đè vào file <code>src/UI/Friday.Portfolio/wwwroot/data/profile.json</code> trong dự án và Push Git!</span>
                    }
                    else
                    {
                        <span>After editing, click the <strong>Download profile.json</strong> button to overwrite <code>src/UI/Friday.Portfolio/wwwroot/data/profile.json</code> in the project and Push Git!</span>
                    }
                </p>
                <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem;">
                    <button class="btn btn-primary" @onclick="DownloadJson">@Lang.Text("📥 Tải về file profile.json", "📥 Download profile.json")</button>
                    <button class="btn btn-ghost" @onclick="CopyJsonToClipboard">@Lang.Text("📋 Copy mã JSON", "📋 Copy JSON Code")</button>
                    <button class="btn btn-ghost" @onclick="ApplyPreview">@Lang.Text("🔄 Cập nhật xem trước Web", "🔄 Update Web Preview")</button>
                </div>
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <p style="color: #4cd964; margin-top: 1rem;">@statusMessage</p>
                }
            </div>

            <form @onsubmit:preventDefault>
                <h2>@Lang.Text("1. Thông tin chung", "1. General Information")</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
                    <div>
                        <label>@Lang.Text("Họ và tên:", "Full Name:")</label>
                        <input class="form-control" @bind="model.FullName" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                    </div>
                    <div>
                        <label>@Lang.Text("Biệt danh (Nickname):", "Nickname:")</label>
                        <input class="form-control" @bind="model.Nickname" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                    </div>
                    <div>
                        <label>@Lang.Text("Chức danh (Title):", "Job Title:")</label>
                        <input class="form-control" @bind="model.Title" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                    </div>
                    <div>
                        <label>@Lang.Text("Địa điểm (Location):", "Location:")</label>
                        <input class="form-control" @bind="model.Location" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                    </div>
                    <div>
                        <label>@Lang.Text("Email:", "Email:")</label>
                        <input class="form-control" @bind="model.Email" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                    </div>
                    <div>
                        <label>@Lang.Text("Số điện thoại:", "Phone Number:")</label>
                        <input class="form-control" @bind="model.Phone" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                    </div>
                    <div>
                        <label>@Lang.Text("Ngày sinh (DOB):", "Date of Birth (DOB):")</label>
                        <input class="form-control" @bind="model.DateOfBirth" placeholder="20/05/1999" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                    </div>
                    <div>
                        <label>@Lang.Text("Website URL (Tự chọn):", "Website URL (Optional):")</label>
                        <input class="form-control" @bind="model.WebsiteUrl" placeholder="@Lang.Text("Để trống sẽ tự lấy link web hiện tại", "Leave blank to use current web URL")" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                    </div>
                    <div>
                        <label>@Lang.Text("Link LinkedIn:", "LinkedIn Link:")</label>
                        <input class="form-control" @bind="model.LinkedIn" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                    </div>
                    <div>
                        <label>@Lang.Text("Link NuGet:", "NuGet Link:")</label>
                        <input class="form-control" @bind="model.NuGet" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                    </div>
                </div>

                <div style="margin-bottom: 2rem;">
                    <label>@Lang.Text("Tóm tắt bản thân (Summary):", "Summary:")</label>
                    <textarea @bind="model.Summary" rows="4" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;"></textarea>
                </div>

                <div style="margin-bottom: 2rem;">
                    <label>@Lang.Text("Mục tiêu nghề nghiệp (Objective):", "Career Objective:")</label>
                    <textarea @bind="model.Objective" rows="3" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;"></textarea>
                </div>

                <h2>@Lang.Text("2. Kinh nghiệm làm việc", "2. Work Experience")</h2>
                @foreach (var exp in model.Experiences)
                {
                    <div style="background: rgba(255,255,255,0.03); padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid rgba(255,255,255,0.1);">
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.5rem;">
                            <div>
                                <label>@Lang.Text("Công ty / Tổ chức:", "Company / Organization:")</label>
                                <input @bind="exp.Company" style="width: 100%; padding: 6px;" />
                            </div>
                            <div>
                                <label>@Lang.Text("Vị trí / Role:", "Position / Role:")</label>
                                <input @bind="exp.Role" style="width: 100%; padding: 6px;" />
                            </div>
                            <div>
                                <label>@Lang.Text("Thời gian:", "Period / Duration:")</label>
                                <input @bind="exp.Period" style="width: 100%; padding: 6px;" />
                            </div>
                            <div>
                                <label>@Lang.Text("Địa điểm:", "Location:")</label>
                                <input @bind="exp.Location" style="width: 100%; padding: 6px;" />
                            </div>
                        </div>
                    </div>
                }

                <h2>@Lang.Text("3. Xem trước Mã JSON xuất ra", "3. Preview Exported JSON Code")</h2>
                <textarea readonly rows="12" style="width: 100%; font-family: monospace; padding: 12px; border-radius: 8px; background: #0d1117; color: #58a6ff;">@ProfileService.ExportToJson()</textarea>
            </form>
        </div>
    </section>
}

@code {
    private ProfileModel? model;
    private bool isAuthenticated;
    private string inputPassword = string.Empty;
    private string errorMessage = string.Empty;
    private string statusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            model = await ProfileService.GetProfileAsync();
        }
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;
        var success = await AuthService.LoginAsync(inputPassword);
        if (success)
        {
            isAuthenticated = true;
            model = await ProfileService.GetProfileAsync();
        }
        else
        {
            errorMessage = Lang.Text("Mật khẩu không chính xác. Vui lòng thử lại.", "Incorrect password. Please try again.");
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        isAuthenticated = false;
    }

    private void ApplyPreview()
    {
        if (model != null)
        {
            ProfileService.UpdateProfileInMemory(model);
            statusMessage = Lang.Text("✅ Đã cập nhật xem trước trong phiên làm việc hiện tại!", "✅ Web preview updated for current session!");
        }
    }

    private async Task CopyJsonToClipboard()
    {
        ApplyPreview();
        var json = ProfileService.ExportToJson();
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);
        statusMessage = Lang.Text("📋 Đã copy toàn bộ mã JSON vào Clipboard của bạn!", "📋 Copied all JSON code to Clipboard!");
    }

    private async Task DownloadJson()
    {
        ApplyPreview();
        var json = ProfileService.ExportToJson();
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        var base64 = Convert.ToBase64String(bytes);
        var url = $"data:application/json;base64,{base64}";
        await JS.InvokeVoidAsync("open", url, "_blank");
        statusMessage = Lang.Text("📥 Đã tạo liên kết tải file profile.json!", "📥 Created download link for profile.json!");
    }
}

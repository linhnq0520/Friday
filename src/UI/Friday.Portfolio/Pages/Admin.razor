@page "/admin"
@page "/editor"
@implements IDisposable
@using Friday.Portfolio.Models
@using Friday.Portfolio.Services
@inject ProfileService ProfileService
@inject AdminAuthService AuthService
@inject LanguageService Lang
@inject GitHubApiService GitHubApi
@inject IJSRuntime JS

<PageTitle>@Lang.Text("Quản Trị & Chỉnh Sửa Profile — CV Editor", "Admin & Profile Editor — CV Editor")</PageTitle>

<section class="section page-hero">
    <div class="section-inner">
        <p class="section-label">@Lang.Text("⚡ Quản trị / Trình biên tập CMS", "⚡ Admin / CMS Editor")</p>
        <h1>@Lang.Text("Chỉnh Sửa Thông Tin Profile & CV Online", "Edit Online Profile & CV Information")</h1>
        <p class="section-lead">@Lang.Text("Chỉnh sửa linh hoạt thông tin cá nhân, kinh nghiệm, kỹ năng, dự án, học vấn và đồng bộ lên GitHub.", "Flexibly edit personal information, experience, skills, projects, education and sync to GitHub.")</p>
    </div>
</section>

@if (!isAuthenticated)
{
    <section class="section">
        <div class="section-inner" style="max-width: 480px; margin: 0 auto; background: var(--card-bg, #1a1e24); padding: 2rem; border-radius: 12px; border: 1px solid var(--border-color, #2a2f38);">
            <h2 style="margin-top: 0;">@Lang.Text("🔒 Xác Thực Quản Trị", "🔒 Admin Authentication")</h2>
            <p>@Lang.Text("Vui lòng nhập mật khẩu quản trị để chỉnh sửa thông tin Profile & CV:", "Please enter the admin password to edit Profile & CV information:")</p>

            <form @onsubmit="HandleLogin">
                <div style="margin-bottom: 1.5rem;">
                    <label style="display: block; margin-bottom: 6px;">@Lang.Text("Mật khẩu Admin:", "Admin Password:")</label>
                    <input type="password" @bind="inputPassword" placeholder="@Lang.Text("Nhập mật khẩu Admin...", "Enter Admin password...")" style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #3a3f48; background: #0f1217; color: #fff;" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p style="color: #ff4d4f; font-size: 0.9rem; margin-bottom: 1rem;">@errorMessage</p>
                }

                <div style="display: flex; gap: 1rem;">
                    <button type="submit" class="btn btn-primary" style="width: 100%;">@Lang.Text("Đăng Nhập Quản Trị", "Admin Login")</button>
                </div>
            </form>
        </div>
    </section>
}
else if (model == null)
{
    <section class="section">
        <div class="section-inner">
            <p>@Lang.Text("Đang tải dữ liệu...", "Loading data...")</p>
        </div>
    </section>
}
else
{
    <section class="section">
        <div class="section-inner">
            <!-- GitHub Direct API Sync Card -->
            <div style="background: var(--card-bg, #1a1e24); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; border: 1px solid var(--border-color, #2a2f38);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                    <h3 style="margin: 0;">🚀 @Lang.Text("Đồng bộ trực tiếp qua GitHub API", "Direct Sync via GitHub API")</h3>
                    <button class="btn btn-ghost" @onclick="HandleLogout" style="font-size: 0.85rem;">@Lang.Text("🔒 Đăng xuất Quản trị", "🔒 Admin Logout")</button>
                </div>
                <p style="margin-top: 0.5rem; color: #a0a6b0; font-size: 0.95rem;">
                    @Lang.Text("Nhập GitHub Personal Access Token (PAT) để Commit & Push file profile.json tự động lên repo linhnq0520/Friday. GitHub Action sẽ tự động deploy trang mới!", "Enter a GitHub Personal Access Token (PAT) to automatically Commit & Push profile.json to repo linhnq0520/Friday. GitHub Action will auto-deploy the site!")
                </p>

                <div style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px; margin-top: 1rem; border: 1px solid rgba(255,255,255,0.08);">
                    <label style="display: block; font-weight: 600; margin-bottom: 6px;">
                        🔑 @Lang.Text("GitHub Personal Access Token (PAT):", "GitHub Personal Access Token (PAT):")
                    </label>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <input type="password" @bind="githubPat" placeholder="github_pat_..." style="flex: 1; min-width: 260px; padding: 8px 12px; border-radius: 6px; border: 1px solid #3a3f48; background: #0f1217; color: #fff;" />
                        <button class="btn btn-ghost" @onclick="SavePat" style="font-size: 0.85rem;">💾 @Lang.Text("Lưu Token", "Save Token")</button>
                        @if (!string.IsNullOrEmpty(githubPat))
                        {
                            <button class="btn btn-ghost" @onclick="ClearPat" style="font-size: 0.85rem; color: #ff4d4f;">🗑️ @Lang.Text("Xoá Token", "Clear Token")</button>
                        }
                    </div>
                </div>

                <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.25rem; align-items: center;">
                    <button class="btn btn-primary" @onclick="PushToGitHub" disabled="@isPushingToGitHub" style="background: #238636; border-color: #2ea043;">
                        @if (isPushingToGitHub)
                        {
                            <span>⏳ @Lang.Text("Đang Push lên GitHub...", "Pushing to GitHub...")</span>
                        }
                        else
                        {
                            <span>🚀 @Lang.Text("Commit & Push lên GitHub", "Commit & Push to GitHub")</span>
                        }
                    </button>
                    <button class="btn btn-ghost" @onclick="DownloadJson">📥 @Lang.Text("Tải file profile.json", "Download profile.json")</button>
                    <button class="btn btn-ghost" @onclick="CopyJsonToClipboard">📋 @Lang.Text("Copy mã JSON", "Copy JSON Code")</button>
                    <button class="btn btn-ghost" @onclick="ApplyPreview">🔄 @Lang.Text("Xem trước Web", "Web Preview")</button>
                </div>

                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <p style="color: #4cd964; margin-top: 1rem; font-weight: 500;">@((MarkupString)statusMessage)</p>
                }
                @if (!string.IsNullOrEmpty(githubErrorMessage))
                {
                    <p style="color: #ff4d4f; margin-top: 1rem; word-break: break-word;">@githubErrorMessage</p>
                }
            </div>

            <form @onsubmit:preventDefault>
                <!-- 1. Thông tin chung -->
                <div style="background: var(--card-bg, #1a1e24); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; border: 1px solid var(--border-color, #2a2f38);">
                    <h2 style="margin-top: 0;">👤 @Lang.Text("1. Thông tin chung & Liên hệ", "1. General Information & Contact")</h2>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Họ và tên:", "Full Name:")</label>
                            <input class="form-control" @bind="model.FullName" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Biệt danh (Nickname):", "Nickname:")</label>
                            <input class="form-control" @bind="model.Nickname" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Chức danh (Title):", "Job Title:")</label>
                            <input class="form-control" @bind="model.Title" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Tagline / Khẩu hiệu:", "Tagline:")</label>
                            <input class="form-control" @bind="model.Tagline" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Địa điểm (Location):", "Location:")</label>
                            <input class="form-control" @bind="model.Location" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Email:", "Email:")</label>
                            <input class="form-control" @bind="model.Email" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Số điện thoại:", "Phone Number:")</label>
                            <input class="form-control" @bind="model.Phone" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Ngày sinh (DOB):", "Date of Birth (DOB):")</label>
                            <input class="form-control" @bind="model.DateOfBirth" placeholder="20/05/1999" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Website URL (Tự chọn):", "Website URL (Optional):")</label>
                            <input class="form-control" @bind="model.WebsiteUrl" placeholder="@Lang.Text("Để trống sẽ tự lấy link web hiện tại", "Leave blank to use current web URL")" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Link LinkedIn:", "LinkedIn Link:")</label>
                            <input class="form-control" @bind="model.LinkedIn" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Tên hiển thị LinkedIn:", "LinkedIn Display Text:")</label>
                            <input class="form-control" @bind="model.LinkedInDisplay" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Link NuGet:", "NuGet Link:")</label>
                            <input class="form-control" @bind="model.NuGet" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">@Lang.Text("Link Bon GitHub Repo:", "Bon Framework GitHub Link:")</label>
                            <input class="form-control" @bind="model.BonGitHub" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                    </div>

                    <div style="margin-bottom: 1.5rem;">
                        <label style="font-weight: 600;">@Lang.Text("Tóm tắt bản thân (Summary):", "Summary:")</label>
                        <textarea @bind="model.Summary" rows="3" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;"></textarea>
                    </div>

                    <div>
                        <label style="font-weight: 600;">@Lang.Text("Mục tiêu nghề nghiệp (Objective):", "Career Objective:")</label>
                        <textarea @bind="model.Objective" rows="3" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;"></textarea>
                    </div>
                </div>

                <!-- 2. Kỹ năng chuyên môn -->
                <div style="background: var(--card-bg, #1a1e24); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; border: 1px solid var(--border-color, #2a2f38);">
                    <h2 style="margin-top: 0;">🛠️ @Lang.Text("2. Kỹ năng chuyên môn (Technical Skills)", "2. Technical Skills")</h2>
                    <p style="color: #a0a6b0; font-size: 0.9rem; margin-top: -0.5rem;">@Lang.Text("Phân cách các kỹ năng bằng dấu phẩy (,)", "Separate skills with commas (,)--")</p>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
                        <div>
                            <label style="font-weight: 600;">💻 @Lang.Text("Ngôn ngữ lập trình (Languages):", "Programming Languages:")</label>
                            <input value="@GetJoined(model.Languages)" @onchange="@(e => model.Languages = ParseJoined(e.Value?.ToString()))" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">⚡ @Lang.Text("Frameworks / Nền tảng:", "Frameworks & Platforms:")</label>
                            <input value="@GetJoined(model.Frameworks)" @onchange="@(e => model.Frameworks = ParseJoined(e.Value?.ToString()))" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">🗄️ @Lang.Text("Cơ sở dữ liệu (Databases):", "Databases:")</label>
                            <input value="@GetJoined(model.Databases)" @onchange="@(e => model.Databases = ParseJoined(e.Value?.ToString()))" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                        <div>
                            <label style="font-weight: 600;">🔧 @Lang.Text("Công cụ & Nền tảng (Tools):", "Tools & Platforms:")</label>
                            <input value="@GetJoined(model.Tools)" @onchange="@(e => model.Tools = ParseJoined(e.Value?.ToString()))" style="width: 100%; padding: 8px; border-radius: 6px; margin-top: 4px;" />
                        </div>
                    </div>
                </div>

                <!-- 3. Kinh nghiệm làm việc -->
                <div style="background: var(--card-bg, #1a1e24); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; border: 1px solid var(--border-color, #2a2f38);">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
                        <h2 style="margin: 0;">💼 @Lang.Text("3. Kinh nghiệm làm việc (Work Experience)", "3. Work Experience")</h2>
                        <button type="button" class="btn btn-primary" @onclick="AddExperience" style="font-size: 0.85rem;">
                            ➕ @Lang.Text("Thêm kinh nghiệm mới", "Add Experience")
                        </button>
                    </div>

                    @for (int i = 0; i < model.Experiences.Count; i++)
                    {
                        var index = i;
                        var exp = model.Experiences[index];
                        <div style="background: rgba(255,255,255,0.03); padding: 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid rgba(255,255,255,0.1);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px dashed rgba(255,255,255,0.1);">
                                <h4 style="margin: 0; color: #58a6ff;">#@(index + 1) — @(string.IsNullOrWhiteSpace(exp.Company) ? "Công ty mới" : exp.Company)</h4>
                                <div style="display: flex; gap: 0.5rem;">
                                    <button type="button" class="btn btn-ghost" @onclick="() => MoveExperienceUp(index)" disabled="@(index == 0)" title="Di chuyển lên" style="padding: 4px 8px; font-size: 0.8rem;">⬆️</button>
                                    <button type="button" class="btn btn-ghost" @onclick="() => MoveExperienceDown(index)" disabled="@(index == model.Experiences.Count - 1)" title="Di chuyển xuống" style="padding: 4px 8px; font-size: 0.8rem;">⬇️</button>
                                    <button type="button" class="btn btn-ghost" @onclick="() => RemoveExperience(index)" style="padding: 4px 8px; font-size: 0.8rem; color: #ff4d4f;">🗑️ @Lang.Text("Xoá", "Delete")</button>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; margin-bottom: 1rem;">
                                <div>
                                    <label style="font-weight: 600;">@Lang.Text("Công ty / Tổ chức:", "Company / Organization:")</label>
                                    <input @bind="exp.Company" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" />
                                </div>
                                <div>
                                    <label style="font-weight: 600;">@Lang.Text("Vị trí / Role:", "Position / Role:")</label>
                                    <input @bind="exp.Role" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" />
                                </div>
                                <div>
                                    <label style="font-weight: 600;">@Lang.Text("Thời gian:", "Period / Duration:")</label>
                                    <input @bind="exp.Period" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" />
                                </div>
                                <div>
                                    <label style="font-weight: 600;">@Lang.Text("Địa điểm:", "Location:")</label>
                                    <input @bind="exp.Location" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" />
                                </div>
                            </div>

                            <!-- Bullets / Achievement lines -->
                            <div style="margin-bottom: 1rem; background: rgba(0,0,0,0.15); padding: 0.75rem; border-radius: 6px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                    <label style="font-weight: 600; font-size: 0.9rem;">📝 @Lang.Text("Mô tả công việc & Thành tựu nổi bật (Bullets):", "Job Responsibilities & Achievements:")</label>
                                    <button type="button" class="btn btn-ghost" @onclick="() => AddBullet(exp)" style="font-size: 0.75rem; padding: 2px 8px;">➕ @Lang.Text("Thêm dòng", "Add Line")</button>
                                </div>
                                @for (int b = 0; b < exp.Bullets.Count; b++)
                                {
                                    var bulletIdx = b;
                                    <div style="display: flex; gap: 0.5rem; margin-bottom: 0.4rem; align-items: center;">
                                        <span style="color: #58a6ff; font-weight: bold;">•</span>
                                        <input value="@exp.Bullets[bulletIdx]" @onchange="@(e => exp.Bullets[bulletIdx] = e.Value?.ToString() ?? "")" style="flex: 1; padding: 6px; border-radius: 4px;" />
                                        <button type="button" class="btn btn-ghost" @onclick="() => RemoveBullet(exp, bulletIdx)" style="padding: 2px 6px; font-size: 0.75rem; color: #ff4d4f;">🗑️</button>
                                    </div>
                                }
                            </div>

                            <!-- Tags -->
                            <div>
                                <label style="font-weight: 600; font-size: 0.9rem;">🏷️ @Lang.Text("Công nghệ sử dụng (phân cách bằng dấu phẩy):", "Technologies Used (separated by commas):")</label>
                                <input value="@GetJoined(exp.Tags)" @onchange="@(e => exp.Tags = ParseJoined(e.Value?.ToString()))" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" placeholder="C#, ASP.NET Core, SQL Server, Redis..." />
                            </div>
                        </div>
                    }
                </div>

                <!-- 4. Dự án cá nhân -->
                <div style="background: var(--card-bg, #1a1e24); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; border: 1px solid var(--border-color, #2a2f38);">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
                        <h2 style="margin: 0;">🚀 @Lang.Text("4. Dự án cá nhân (Personal Projects)", "4. Personal Projects")</h2>
                        <button type="button" class="btn btn-primary" @onclick="AddProject" style="font-size: 0.85rem;">
                            ➕ @Lang.Text("Thêm dự án mới", "Add Project")
                        </button>
                    </div>

                    @for (int i = 0; i < model.Projects.Count; i++)
                    {
                        var index = i;
                        var proj = model.Projects[index];
                        <div style="background: rgba(255,255,255,0.03); padding: 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid rgba(255,255,255,0.1);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px dashed rgba(255,255,255,0.1);">
                                <h4 style="margin: 0; color: #58a6ff;">#@(index + 1) — @(string.IsNullOrWhiteSpace(proj.Title) ? "Dự án mới" : proj.Title)</h4>
                                <div style="display: flex; gap: 0.5rem;">
                                    <button type="button" class="btn btn-ghost" @onclick="() => MoveProjectUp(index)" disabled="@(index == 0)" title="Di chuyển lên" style="padding: 4px 8px; font-size: 0.8rem;">⬆️</button>
                                    <button type="button" class="btn btn-ghost" @onclick="() => MoveProjectDown(index)" disabled="@(index == model.Projects.Count - 1)" title="Di chuyển xuống" style="padding: 4px 8px; font-size: 0.8rem;">⬇️</button>
                                    <button type="button" class="btn btn-ghost" @onclick="() => RemoveProject(index)" style="padding: 4px 8px; font-size: 0.8rem; color: #ff4d4f;">🗑️ @Lang.Text("Xoá", "Delete")</button>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; margin-bottom: 1rem;">
                                <div>
                                    <label style="font-weight: 600;">@Lang.Text("Tên dự án:", "Project Title:")</label>
                                    <input @bind="proj.Title" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" />
                                </div>
                                <div>
                                    <label style="font-weight: 600;">@Lang.Text("Tên nhãn link (UrlLabel):", "Link Label:")</label>
                                    <input @bind="proj.UrlLabel" placeholder="GitHub Repository / Live Demo" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" />
                                </div>
                                <div>
                                    <label style="font-weight: 600;">@Lang.Text("Đường dẫn (URL):", "URL Link:")</label>
                                    <input @bind="proj.Url" placeholder="https://github.com/..." style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" />
                                </div>
                            </div>

                            <div style="margin-bottom: 1rem;">
                                <label style="font-weight: 600;">@Lang.Text("Mô tả dự án:", "Project Description:")</label>
                                <textarea @bind="proj.Description" rows="2" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;"></textarea>
                            </div>

                            <div>
                                <label style="font-weight: 600; font-size: 0.9rem;">🏷️ @Lang.Text("Công nghệ sử dụng (TechStack, phân cách bằng dấu phẩy):", "Tech Stack (separated by commas):")</label>
                                <input value="@GetJoined(proj.TechStack)" @onchange="@(e => proj.TechStack = ParseJoined(e.Value?.ToString()))" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" placeholder="C#, Blazor WASM, gRPC..." />
                            </div>
                        </div>
                    }
                </div>

                <!-- 5. Học vấn -->
                <div style="background: var(--card-bg, #1a1e24); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; border: 1px solid var(--border-color, #2a2f38);">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
                        <h2 style="margin: 0;">🎓 @Lang.Text("5. Học vấn & Bằng cấp (Education)", "5. Education & Qualifications")</h2>
                        <button type="button" class="btn btn-primary" @onclick="AddEducation" style="font-size: 0.85rem;">
                            ➕ @Lang.Text("Thêm học vấn mới", "Add Education")
                        </button>
                    </div>

                    @for (int i = 0; i < model.Education.Count; i++)
                    {
                        var index = i;
                        var edu = model.Education[index];
                        <div style="background: rgba(255,255,255,0.03); padding: 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid rgba(255,255,255,0.1);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px dashed rgba(255,255,255,0.1);">
                                <h4 style="margin: 0; color: #58a6ff;">#@(index + 1) — @(string.IsNullOrWhiteSpace(edu.Institution) ? "Trường / Cơ sở đào tạo" : edu.Institution)</h4>
                                <div style="display: flex; gap: 0.5rem;">
                                    <button type="button" class="btn btn-ghost" @onclick="() => MoveEducationUp(index)" disabled="@(index == 0)" title="Di chuyển lên" style="padding: 4px 8px; font-size: 0.8rem;">⬆️</button>
                                    <button type="button" class="btn btn-ghost" @onclick="() => MoveEducationDown(index)" disabled="@(index == model.Education.Count - 1)" title="Di chuyển xuống" style="padding: 4px 8px; font-size: 0.8rem;">⬇️</button>
                                    <button type="button" class="btn btn-ghost" @onclick="() => RemoveEducation(index)" style="padding: 4px 8px; font-size: 0.8rem; color: #ff4d4f;">🗑️ @Lang.Text("Xoá", "Delete")</button>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem;">
                                <div>
                                    <label style="font-weight: 600;">@Lang.Text("Trường / Cơ sở đào tạo:", "Institution:")</label>
                                    <input @bind="edu.Institution" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" />
                                </div>
                                <div>
                                    <label style="font-weight: 600;">@Lang.Text("Bằng cấp / Chuyên ngành:", "Degree / Major:")</label>
                                    <input @bind="edu.Degree" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" />
                                </div>
                                <div>
                                    <label style="font-weight: 600;">@Lang.Text("Thời gian:", "Period / Duration:")</label>
                                    <input @bind="edu.Period" style="width: 100%; padding: 6px; border-radius: 4px; margin-top: 2px;" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- 6. Xem trước JSON -->
                <div style="background: var(--card-bg, #1a1e24); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; border: 1px solid var(--border-color, #2a2f38);">
                    <h2>📜 @Lang.Text("6. Xem trước Mã JSON xuất ra", "6. Preview Exported JSON Code")</h2>
                    <textarea readonly rows="12" style="width: 100%; font-family: monospace; padding: 12px; border-radius: 8px; background: #0d1117; color: #58a6ff;">@ProfileService.ExportToJson()</textarea>
                </div>
            </form>
        </div>
    </section>
}

@code {
    private ProfileModel? model;
    private bool isAuthenticated;
    private string inputPassword = string.Empty;
    private string errorMessage = string.Empty;
    private string statusMessage = string.Empty;
    private string githubErrorMessage = string.Empty;
    private string githubPat = string.Empty;
    private bool isPushingToGitHub;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            model = await ProfileService.GetProfileAsync();
            githubPat = await GitHubApi.GetTokenAsync() ?? string.Empty;
        }
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;
        var success = await AuthService.LoginAsync(inputPassword);
        if (success)
        {
            isAuthenticated = true;
            model = await ProfileService.GetProfileAsync();
            githubPat = await GitHubApi.GetTokenAsync() ?? string.Empty;
        }
        else
        {
            errorMessage = Lang.Text("Mật khẩu không chính xác. Vui lòng thử lại.", "Incorrect password. Please try again.");
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        isAuthenticated = false;
    }

    private async Task SavePat()
    {
        if (!string.IsNullOrWhiteSpace(githubPat))
        {
            await GitHubApi.SetTokenAsync(githubPat);
            statusMessage = Lang.Text("💾 Đã lưu GitHub PAT vào trình duyệt thành công!", "💾 Saved GitHub PAT to browser successfully!");
            githubErrorMessage = string.Empty;
        }
    }

    private async Task ClearPat()
    {
        await GitHubApi.ClearTokenAsync();
        githubPat = string.Empty;
        statusMessage = Lang.Text("🗑️ Đã xoá GitHub PAT khỏi trình duyệt.", "🗑️ Cleared GitHub PAT from browser.");
        githubErrorMessage = string.Empty;
    }

    private async Task PushToGitHub()
    {
        statusMessage = string.Empty;
        githubErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(githubPat))
        {
            githubErrorMessage = Lang.Text("⚠️ Vui lòng nhập GitHub Personal Access Token (PAT) trước khi Push!", "⚠️ Please enter a GitHub Personal Access Token (PAT) before pushing!");
            return;
        }

        isPushingToGitHub = true;
        try
        {
            ApplyPreview();
            await GitHubApi.SetTokenAsync(githubPat);
            var json = ProfileService.ExportToJson();

            var (success, commitUrl, err) = await GitHubApi.CommitProfileJsonAsync(json, githubPat);

            if (success)
            {
                var commitLinkHtml = !string.IsNullOrEmpty(commitUrl)
                    ? $"<a href='{commitUrl}' target='_blank' style='color: #58a6ff; text-decoration: underline;'>{Lang.Text("Xem commit trên GitHub", "View commit on GitHub")}</a>"
                    : string.Empty;

                statusMessage = Lang.Text(
                    $"🚀 Đã Commit & Push file profile.json thành công lên GitHub! {commitLinkHtml}. GitHub Actions đang tự động deploy bản mới.",
                    $"🚀 Successfully Committed & Pushed profile.json to GitHub! {commitLinkHtml}. GitHub Actions is auto-deploying the new release.");
            }
            else
            {
                githubErrorMessage = Lang.Text($"❌ Push thất bại: {err}", $"❌ Push failed: {err}");
            }
        }
        finally
        {
            isPushingToGitHub = false;
        }
    }

    private void ApplyPreview()
    {
        if (model != null)
        {
            ProfileService.UpdateProfileInMemory(model);
            statusMessage = Lang.Text("✅ Đã cập nhật xem trước trong phiên làm việc hiện tại!", "✅ Web preview updated for current session!");
        }
    }

    private async Task CopyJsonToClipboard()
    {
        ApplyPreview();
        var json = ProfileService.ExportToJson();
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);
        statusMessage = Lang.Text("📋 Đã copy toàn bộ mã JSON vào Clipboard của bạn!", "📋 Copied all JSON code to Clipboard!");
    }

    private async Task DownloadJson()
    {
        ApplyPreview();
        var json = ProfileService.ExportToJson();
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        var base64 = Convert.ToBase64String(bytes);
        var url = $"data:application/json;base64,{base64}";
        await JS.InvokeVoidAsync("open", url, "_blank");
        statusMessage = Lang.Text("📥 Đã tạo liên kết tải file profile.json!", "📥 Created download link for profile.json!");
    }

    // Skills helpers
    private string GetJoined(List<string>? list) => list != null ? string.Join(", ", list) : string.Empty;

    private List<string> ParseJoined(string? input) =>
        string.IsNullOrWhiteSpace(input)
            ? new List<string>()
            : input.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                 .Select(s => s.Trim())
                 .Where(s => !string.IsNullOrEmpty(s))
                 .ToList();

    // Experience helpers
    private void AddExperience()
    {
        if (model == null) return;
        model.Experiences.Add(new ExperienceModel
        {
            Company = "Công ty mới / New Company",
            Role = "Vị trí / Role",
            Period = "2026 - Present",
            Location = "Ho Chi Minh City, Vietnam",
            Bullets = new List<string> { "Nội dung trách nhiệm / Thành tựu..." },
            Tags = new List<string> { "C#", ".NET Core" }
        });
    }

    private void RemoveExperience(int index)
    {
        if (model != null && index >= 0 && index < model.Experiences.Count)
        {
            model.Experiences.RemoveAt(index);
        }
    }

    private void MoveExperienceUp(int index)
    {
        if (model != null && index > 0 && index < model.Experiences.Count)
        {
            var item = model.Experiences[index];
            model.Experiences.RemoveAt(index);
            model.Experiences.Insert(index - 1, item);
        }
    }

    private void MoveExperienceDown(int index)
    {
        if (model != null && index >= 0 && index < model.Experiences.Count - 1)
        {
            var item = model.Experiences[index];
            model.Experiences.RemoveAt(index);
            model.Experiences.Insert(index + 1, item);
        }
    }

    private void AddBullet(ExperienceModel exp)
    {
        exp.Bullets.Add("Nội dung thành tựu mới...");
    }

    private void RemoveBullet(ExperienceModel exp, int bulletIndex)
    {
        if (bulletIndex >= 0 && bulletIndex < exp.Bullets.Count)
        {
            exp.Bullets.RemoveAt(bulletIndex);
        }
    }

    // Projects helpers
    private void AddProject()
    {
        if (model == null) return;
        model.Projects.Add(new ProjectModel
        {
            Title = "Tên dự án mới / Project Title",
            Description = "Mô tả dự án...",
            TechStack = new List<string> { "C#", "Blazor" },
            Url = "https://github.com/...",
            UrlLabel = "GitHub Repo"
        });
    }

    private void RemoveProject(int index)
